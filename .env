# ── SQLite (sandbox-local; the original project used Supabase Postgres) ──
# NOTE: sandbox shell exports DATABASE_URL=file:/home/z/my-project/db/custom.db
# so we align the .env to that path to avoid any precedence surprises.
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# ── Required by app code (JWT signing) ──
JWT_SECRET="itam-nextjs-sandbox-jwt-secret-change-me-9f3a7c1e4b2d8a5f0c6e1b7d3a9f4c2e"

# ── Required by Vercel Cron for stock auto-approval (kept for parity) ──
CRON_SECRET="itam-nextjs-sandbox-cron-secret-7d2a8c4b1e9f5a3d6b0c8e2f1a4b7d3c"

# ── Optional (NextAuth not enabled in this build, but kept for parity) ──
NEXTAUTH_SECRET="itam-nextjs-sandbox-nextauth-secret-2b8d4a6c0e3f1b5a7d9c4e8a2b6d3f1c"

# ── Run-time flags ──
NODE_ENV="development"
