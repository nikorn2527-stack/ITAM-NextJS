{
  "buildCommand": "npx prisma generate && next build --webpack",
  "installCommand": "npm install --legacy-peer-deps",
  "crons": [
    {
      "path": "/api/cron/keepalive",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 8 * * *"
    }
  ],
  "framework": "nextjs",
  "github": {
    "silent": true
  }
}
