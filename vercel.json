{
  "buildCommand": "rm -rf .next && npx prisma generate && npx prisma db push --accept-data-loss && next build --webpack",
  "installCommand": "npm install --legacy-peer-deps",
  "crons": [
    {
      "path": "/api/cron/keepalive",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/sync-legacy",
      "schedule": "0 2 * * *"
    }
  ],
  "regions": ["sin1"],
  "framework": "nextjs",
  "github": {
    "silent": true
  }
}
