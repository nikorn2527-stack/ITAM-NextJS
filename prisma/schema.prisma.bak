// ============================================================
// 2) MeterReading — การจดมิเตอร์
// ============================================================
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1) Device — อุปกรณ์ IT (เครื่องพิมพ์, สแกนเนอร์, คอมพิวเตอร์, ...)
// ============================================================
model Device {
  id              String   @id @default(cuid())
  assetCode       String   @unique // asset_no — เลขสินทรัพย์รวม ห้ามแก้ไข
  name            String // ชื่ออุปกรณ์
  brand           String
  model           String
  type            String // ประเภท: PRINTER | SCANNER | COMPUTER | NETWORK | OTHER
  serialNumber    String? // serial
  status          String   @default("Active")
  site            String // สาขา/ที่ตั้ง
  department      String?
  departmentCode  String?
  parentRef       String?
  assetSiteCode   String? // asset_site_code — รหัสประจำ Site (SITE-NNNNN)
  displayLabel    String? // ป้ายแสดงผลที่ผู้ใช้กำหนดเอง (display label)
  location        String?
  building        String?
  floor           String?
  room            String?
  purchaseDate    String? // ISO date
  purchasePrice   Decimal? @db.Decimal(12, 2)
  salvageValue    Decimal? @default(0) @db.Decimal(12, 2)
  usefulLife      Int?
  warrantyMonths  Int      @default(12)
  warrantyEnd     String?
  vendor          String?
  contractNo      String?
  uninstallDate   String?
  meterRequired   Boolean  @default(false)
  meterMode       String? // TOTAL | BW_COLOR
  lastMeterBw     Int      @default(0)
  lastMeterColor  Int      @default(0)
  ip              String?
  mac             String?
  remoteId        String?
  currentAssignee String?
  remark          String?
  costCenter      String?
  deviceGroup     String?
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       String?  @default("System")

  // ── Asset Tag (Phase 2.6 — future RFID/NFC/BLE support) ──
  // Physical tag identifier for asset tracking beyond QR stickers.
  // Currently unused — field reserved so future hardware integration
  // (USB RFID reader, BLE beacons, NFC tags) doesn't need schema migration.
  // tagType defaults to QR (current system uses Smart QR URLs).
  tagId           String?
  tagType         String   @default("QR") // QR | BARCODE | NFC | RFID_UHF | BLE

  // ── Device Set / Parent-Child (Task ID 9, Phase 2) ──
  // Lets devices be grouped as a "set": e.g. a printer (parent) with
  // its UPS, network card, paper tray (children). Children may or may not
  // have their own assetCode (if not, use a generated placeholder).
  // `parentDeviceId` is a self-FK; onDelete: SetNull so deleting a parent
  // doesn't cascade-delete children (they become orphaned but kept).
  parentDeviceId String?
  parentDevice   Device?  @relation("DeviceSetChildren", fields: [parentDeviceId], references: [id], onDelete: SetNull)
  childDevices   Device[] @relation("DeviceSetChildren")
  setLabel       String? // ชื่อชุด เช่น "ชุดเครื่องพิมพ์ห้องจ่ายยา"
  setPosition    Int? // ลำดับในชุด (1, 2, 3, …)

  // ── Device Replacement ──
  // When this device is replaced by a newer one, `replacedById` points
  // to the new device. Smart QR scan on the old device will then redirect
  // to the new one (so the sticker on the old physical box still works).
  // Self-FK; onDelete: SetNull so deleting the new device doesn't cascade.
  replacedById    String?
  replacedBy      Device?  @relation("DeviceReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replacedByFrom  Device[] @relation("DeviceReplacement")
  replacedAt      DateTime?

  // ── Phase 4.2: Soft-delete ──
  // Set by future soft-delete handlers instead of `db.device.delete()`.
  // Existing DELETE endpoints currently hard-delete — a follow-up task will
  // migrate them to set deletedAt = now() and filter reads by deletedAt IS NULL.
  // Kept optional so existing rows are unaffected.
  deletedAt       DateTime?

  // Relations (other models reference Device via deviceId)
  meterReadings     MeterReading[]
  transfers         DeviceTransfer[]
  assignments       Assignment[]
  maintenanceLogs   MaintenanceLog[]
  workOrders        WorkOrder[]
  stockTransactions StockTransaction[]
  pmSchedules       PMSchedule[]
  accessories       DeviceAccessory[]
  licenses          LicenseRecord[]   // PUBLIC-QR-PHASE-1-SCHEMA — real FK from LicenseRecord.deviceId

  @@index([parentDeviceId])
  @@index([status])
  @@index([site])
  @@index([serialNumber])
  @@index([replacedById])
  @@index([deletedAt]) // Phase 4.2: soft-delete index
}

model MeterReading {
  id                      String   @id @default(cuid())
  readingId               String?  @unique
  deviceId                String
  assetCode               String? // asset_no — สำหรับ CSV import lookup
  readingDate             String // ISO date
  readingMonth            String? // YYYY-MM
  meterBw                 Int      @default(0)
  meterColor              Int      @default(0)
  pagesBw                 Int      @default(0)
  pagesColor              Int      @default(0)
  prevMeterBw             Int      @default(0)
  prevMeterColor          Int      @default(0)
  // Snapshot of Device.meterMode at the time of this reading (TOTAL | BW_COLOR | null).
  // Lets us reconstruct the meter configuration when the reading was taken, so
  // mode-switch detection works even after device.meterMode has changed.
  meterMode               String? // TOTAL | BW_COLOR
  // Snapshot of the previous reading's meterMode — makes mode transitions
  // explicit and queryable (e.g. "show me all TOTAL→BW_COLOR transitions").
  prevMeterMode           String?
  readingType             String? // MONTHLY | INITIAL | FINAL | RESET | CHECKOUT | SEND_REPAIR | RETURN | TRANSFER
  readBy                  String?
  remark                  String?
  locationAtReading       String?
  siteAtReading           String?
  buildingAtReading       String?
  floorAtReading          String?
  departmentAtReading     String?
  departmentCodeAtReading String?
  eventType               String?
  eventId                 String?
  isDemo                  Boolean  @default(false)
  createdAt               DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  updatedAt DateTime? @updatedAt
  // ── Phase 4.2: Soft-delete ──
  // Optional timestamp; when set, the reading is considered deleted but kept
  // for audit. Existing DELETE endpoints still hard-delete — a follow-up
  // task will migrate them to set deletedAt = now().
  deletedAt DateTime?
  @@index([deviceId])
  @@index([readingMonth])
  @@index([isDemo])
  @@index([deletedAt]) // Phase 4.2: soft-delete index
  // Composite indexes for common query patterns
  @@index([deviceId, readingMonth])       // meter readings per device per month
  @@index([readingType, readingDate])     // filter by type + date range
  @@index([readingDate])                  // date range queries (dashboard)
  @@index([deviceId, readingDate])        // latest reading per device
}

// ============================================================
// 3) Cycle — รอบจดมิเตอร์
//    `site` is optional — null means "all sites" (a global cycle).
//    When set, the cycle is scoped to that site code (e.g. "UDH").
// ============================================================
model Cycle {
  id        String   @id @default(cuid())
  name      String
  startDate String
  endDate   String
  status    String   @default("active")
  site      String? // nullable — null = all sites (global cycle)
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  isDemo    Boolean  @default(false)
  @@index([status])
  @@index([site])
  @@index([updatedAt])
}

// ============================================================
// 4) DeviceTransfer — ประวัติการย้าย
// ============================================================
model DeviceTransfer {
  id                 String   @id @default(cuid())
  logId              String?  @unique
  deviceId           String
  isDemo           Boolean  @default(false)
  assetCode          String? // Asset_No
  moveDate           String?
  action             String? // TRANSFER | TRANSFER_SITE | STATUS_CHANGE | STATUS_AND_TRANSFER | TRANSFER_BY_LIFECYCLE
  fromStatus         String?
  toStatus           String?
  fromSite           String?
  fromAssetSiteCode  String?
  fromBuilding       String?
  fromFloor          String?
  fromDepartment     String?
  fromDepartmentCode String?
  fromLocation       String?
  toSite             String
  toAssetSiteCode    String?
  toBuilding         String?
  toFloor            String?
  toDepartment       String?
  toDepartmentCode   String?
  toLocation         String?
  meterReadingId     String?
  movedBy            String?
  remark             String?
  transferDate       String
  reason             String?
  createdAt          DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  updatedAt DateTime? @updatedAt
  @@index([deviceId])
  @@index([toSite])
}

// ============================================================
// 5) Assignment — การมอบหมายอุปกรณ์
// ============================================================
model Assignment {
  id                 String   @id @default(cuid())
  assignmentId       String?  @unique
  deviceId           String
  isDemo          Boolean  @default(false)
  assignee           String
  assigneeRole       String?
  department         String?
  checkoutDate       String
  expectedReturnDate String?
  actualReturnDate   String?
  status             String   @default("active")
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([assignee])
}

// ============================================================
// 6) MaintenanceLog — ประวัติซ่อมบำรุง
// ============================================================
model MaintenanceLog {
  id           String   @id @default(cuid())
  logId        String?  @unique
  deviceId     String
  isDemo          Boolean  @default(false)
  type         String // repair | maintenance | inspection | upgrade
  status       String   @default("open")
  startDate    String
  endDate      String?
  cost         Decimal? @db.Decimal(12, 2)
  vendor       String?
  description  String
  resolvedNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
}

// ============================================================
// 7) WorkOrder — ใบงานแจ้งซ่อม
// ============================================================
model WorkOrder {
  id               String    @id @default(cuid())
  woNumber         String?   @unique
  // Legacy source identifier; immutable for traceability when supplied by imports.
  legacyJobNo      String?   @map("legacy_job_no")
  // New ITAM-NextJS identifier; woNumber remains as the compatibility display field.
  systemJobNo      String?   @unique @map("system_job_no")
  requestId        String?   @unique
  subject          String
  building         String?
  location         String?
  details          String?
  priority         String    @default("ปกติ")
  reporterName     String?
  reporterEmail    String?
  tel              String?
  employeeCode     String?
  submissionSource String    @default("guest")
  trackable        Boolean   @default(false)
  lineUserId       String?
  lineMessageId    String?   @unique
  printTemplateId  String?
  externalMeta     String?
  picBefore        String?
  picOnsite        String?
  picAfter         String?
  status           String    @default("PENDING")
  acceptStatus     String?
  assignedTo       String?
  assignedBy       String?
  assignedAt       DateTime?
  assignmentNote   String?
  detailsAdmin     String?
  dateAdmin        String?
  resolution       String?
  resolutionGroup  String?
  editUnlockActive Boolean   @default(false)
  editUnlockBy     String?
  editUnlockAt     DateTime?
  editUnlockNote   String?
  workCompletedAt  DateTime?
  closedAt         DateTime?
  canceledAt       DateTime?
  cancelReason     String?
  deviceId         String?
  isDemo           Boolean   @default(false)
  isSpecialFee     Boolean   @default(false) // งานพิเศษ (มีค่าใช้จ่าย) — แอปอื่นดึงผ่าน API
  // ── Site-based access control (Phase 0: transitional) ──
  // Direct Site reference so work orders without a device can still be
  // scoped. For work orders with a device, the server derives siteCode
  // from Device.site on create/update. Null = external/unassigned (uses
  // a separate authorization flow — never means "all sites").
  // See: Site-Based Access Control Guidance for ITAM-NextJS.md §5.1
  siteCode         String?
  // B4 FIX: Optimistic concurrency version field.
  // Incremented on every update. Callers can send `expectedVersion` in
  // PUT/PATCH to detect concurrent modification (409 Conflict).
  // Used with serializable transaction for device reassignment.
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // ── Public QR Repair Submission ──
  // When a work order is submitted via public QR scan (no staff login),
  // `publicReporterId` links to the PublicReporter record (LINE-verified
  // or anonymous with phone). `submissionSource` is reused for the source
  // flag: 'guest' (default), 'line_liff', 'public_qr', 'app'.
  publicReporterId String?
  publicReporter   PublicReporter? @relation(fields: [publicReporterId], references: [id], onDelete: SetNull)

  device   Device?            @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  messages WorkOrderMessage[]
  reviews  WorkOrderReview[]
  images   WorkOrderImage[]
  parts    WorkOrderPart[]

  // ── Phase 4.2: Soft-delete ──
  // Optional timestamp; when set, the WO is considered deleted but kept for
  // audit. Existing DELETE endpoints still hard-delete — a follow-up task
  // will migrate them to set deletedAt = now().
  deletedAt DateTime?

  @@index([status])
  @@index([legacyJobNo])
  @@index([assignedTo])
  @@index([deviceId])
  @@index([isDemo])
  @@index([isSpecialFee])
  @@index([siteCode, status, createdAt])
  @@index([version])
  @@index([publicReporterId])
  @@index([deletedAt]) // Phase 4.2: soft-delete index
}

// ============================================================
// 8) WorkOrderMessage — แชทในใบงาน
// ============================================================
model WorkOrderMessage {
  id          String   @id @default(cuid())
  workOrderId String
  isDemo      Boolean  @default(false)
  message     String
  author      String?
  authorRole  String?
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  updatedAt DateTime? @updatedAt
  @@index([workOrderId])
}

// ============================================================
// 9) WorkOrderReview — คะแนนความพึงพอใจ
// ============================================================
model WorkOrderReview {
  id          String   @id @default(cuid())
  workOrderId String
  isDemo      Boolean  @default(false)
  rating      Int
  comment     String?
  reviewedBy  String?
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  updatedAt DateTime? @updatedAt
  @@index([workOrderId])
}

// ============================================================
// 10) WorkOrderImage — รูปภาพในใบงาน (หลายรูปต่อขั้นตอน)
// ============================================================
model WorkOrderImage {
  id          String   @id @default(cuid())
  workOrderId String
  isDemo      Boolean  @default(false)
  stage       String // before | onsite | after
  image_data  String
  fileName    String?
  uploadedBy  String?
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  updatedAt DateTime? @updatedAt
  @@index([workOrderId])
  @@index([stage])
  @@map("work_order_images")
}

// ============================================================
// 10b) WorkOrderPart — คำขออะไหล่ในใบงาน (Task ID: P0-SCHEMA-FIXES)
//     Referenced by CompleteDialog Step 2 (work-orders-page.tsx).
//     Tracks each part requested against a WorkOrder, with optional
//     StockItem linkage and an approval workflow (PENDING -> APPROVED/REJECTED).
// ============================================================
model WorkOrderPart {
  id          String     @id @default(cuid())
  workOrderId String
  isDemo      Boolean  @default(false)
  workOrder   WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  stockItemId String?
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id])
  productCode String
  productName String
  quantity    Int
  unitCost    Decimal?   @db.Decimal(12, 2)
  totalCost   Decimal?   @db.Decimal(12, 2)
  status      String     @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedBy String?
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([workOrderId])
  @@index([status])
  @@index([stockItemId])
}

// ============================================================
// 11) LicenseRecord — ลิขสิทธิ์ซอฟต์แวร์
// ============================================================
model LicenseRecord {
  id          String   @id @default(cuid())
  License_ID  String?
  Asset_No    String? // links to Device.assetCode (legacy — kept for back-compat)
  Software    String
  LicenseType String? // OEM | Volume | Retail | Subscription | Open License
  License_Key String?
  Quantity    Int      @default(1)
  Expiry_Date String?
  Remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ── PUBLIC-QR-PHASE-1-SCHEMA: real FK to Device (replaces legacy Asset_No
  //     string lookup). Nullable so the migration script can backfill
  //     existing rows in place (see scripts/migrate-license-device-id.ts).
  //     onDelete: SetNull so deleting a Device keeps the license record
  //     (audit trail) instead of cascading the delete.
  deviceId    String?
  device      Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  // ── PUBLIC-QR-PHASE-1-SCHEMA: active flag — when a device is replaced and
  //     moveLicenses=false, the licenses on the old device get deactivated
  //     (isActive=false) instead of being deleted, preserving the audit
  //     trail of "this license was issued for that device".
  isActive    Boolean  @default(true)

  isDemo    Boolean  @default(false)
  @@index([Asset_No])
  @@index([deviceId])
  @@index([isActive])
  @@index([isDemo])
  @@map("license_records")
}

// ============================================================
// 12) SiteAttribute — ข้อมูลสาขา + อัตราค่ากระดาษ
//     Source: sheet "Site_Attributes"
// ============================================================
model SiteAttribute {
  id             String   @id @default(cuid())
  SiteCode       String   @unique // เช่น UDH, NKP, MECUD, PPIT
  SiteName       String? // เช่น โรงพยาบาลศูนย์อุดรธานี
  LineOA         String? // LINE OA ID/Token
  Hotline        String? // เบอร์ติดต่อ
  PaperRateBW    Decimal? @default(0.5) @db.Decimal(12, 2) // ฿/แผ่น ขาวดำ
  PaperRateColor Decimal? @default(2.0) @db.Decimal(12, 2) // ฿/แผ่น สี
  TelegramChatId String?  @map("TelegramChatId") // Telegram chat ID สำหรับสาขา
  EmailAddress   String?  @map("EmailAddress") // อีเมลสาขาสำหรับรับแจ้งเตือน

  // ── LINE Login (public QR scan → repair flow) ──
  // PPIT (single org) uses ONE shared LINE Login Channel. But each site
  // has its OWN LINE OA (for friend add + notifications). When a public
  // reporter logs in via LINE Login, we auto-friend them to the site's
  // LINE OA so they can receive status updates via that OA.
  // LiffId is optional — used only if we deploy as a LIFF app (in-LINE).
  LiffId                 String?  @map("LiffId")
  LiffAutoFriendLine     String?  @map("LiffAutoFriendLine") // LINE OA handle to auto-friend on login
  // Public repair rate-limit per site (per phone/day, per IP/day)
  PublicRepairDailyLimit Int     @default(3) // max WO/phone/day
  PublicRepairIpDailyLimit Int    @default(10) // max WO/IP/day

  isDemo         Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  publicReporters PublicReporter[]

  @@map("site_attributes")
  @@index([isDemo])
}

// ============================================================
// 13) Site — สาขา (legacy, ใช้คู่กับ SiteAttribute)
// ============================================================
model Site {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())

  isDemo    Boolean  @default(false)
  updatedAt DateTime? @updatedAt
  @@index([name])
}

// ============================================================
// 14) SiteRate — อัตราค่ากระดาษต่อสาขา (legacy)
// ============================================================
model SiteRate {
  id        String   @id @default(cuid())
  siteCode  String
  bwRate    Decimal  @default(0.5) @db.Decimal(12, 2)
  colorRate Decimal  @default(2.0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  isDemo    Boolean  @default(false)
  @@index([siteCode])
}

// ============================================================
// 15) MasterItem — ข้อมูลมาตรฐาน (Brand, Type, Model, Department, Status, DeviceGroup, Site)
// ============================================================
model MasterItem {
  id           String   @id @default(cuid())
  category     String // category column from Excel
  code         String // code column (DC-001, DEP-001, IT-PRN, etc.)
  label        String // label column (display name)
  brand        String? // brand (for DeviceClassification)
  model        String? // model (for DeviceClassification)
  deviceType   String? // deviceType (for DeviceClassification)
  parentRef    String? // parentRef (Affiliation label for Department, IT-PRN for RepairRequest, etc.)
  displayLabel String? // displayLabel column
  siteCode     String? // siteCode column (ALL, UDH, etc.)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  isDemo    Boolean  @default(false)
  @@index([category])
  @@index([code])
}

// ============================================================
// 16) StockItem — สินค้าในสต็อก
// ============================================================
model StockItem {
  id                String   @id @default(cuid())
  productCode       String   @unique
  productName       String
  category          String?
  brand             String?
  model             String?
  unit              String   @default("ชิ้น")
  quantity          Int      @default(0)
  minQuantity       Int      @default(0)
  maxQuantity       Int      @default(0)
  unitCost          Decimal? @db.Decimal(12, 2)
  totalValue        Decimal? @db.Decimal(12, 2)
  location          String?
  site              String?
  compatibleDevices String?
  remark            String?
  active            Boolean  @default(true)
  isDemo            Boolean  @default(false)
  lastUpdated       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // ── Cost Analytics (COST-ANALYTICS-SPEC.md Phase 1) ──
  costType           String?
  yieldPerPage       Int?
  depreciationMethod String?
  usefulLifeMonths   Int?
  usefulLifePages    Int?

  // ── WO-PARTS-FLOW Level 2+: flexible cost model + usage defaults ──
  // The cost model determines how this item is charged in WO parts requests.
  //   'fixed'      — one-time cost per unit (default, backward compat)
  //   'per-page'   — cost = pages printed × ratePerPage (e.g. paper contracts)
  //   'per-hour'   — cost = hours used × ratePerHour (e.g. rental equipment)
  //   'monthly'    — flat monthly fee, charged regardless of usage (e.g. service contracts)
  //   'per-device' — cost per device serviced (e.g. visit fee)
  costModel          String? // 'fixed' | 'per-page' | 'per-hour' | 'monthly' | 'per-device'
  // Default usage assumptions used by the parts picker UI to pre-fill
  // usageQuantity when this item is added to a WO. Saves the technician
  // from having to guess. Can be overridden per-request.
  //   expectedDevicesPerUnit — e.g. ink bottle fills 3 devices → 1/3 = 0.333
  //   expectedHoursPerUnit   — e.g. rental item lasts 8 hours per charge → 8
  //   expectedPagesPerUnit   — e.g. toner cartridge yields 1500 pages → 1500
  expectedDevicesPerUnit Int?
  expectedHoursPerUnit   Int?
  expectedPagesPerUnit   Int?
  // The rate used for non-'fixed' cost models:
  //   per-page  → ratePerPage (฿ per page)
  //   per-hour  → ratePerHour (฿ per hour)
  //   monthly   → ratePerMonth (฿ per month)
  //   per-device → ratePerDevice (฿ per device serviced)
  // For 'fixed' model, the existing unitCost field is used.
  ratePerPage     Decimal? @db.Decimal(12, 2)
  ratePerHour     Decimal? @db.Decimal(12, 2)
  ratePerMonth    Decimal? @db.Decimal(12, 2)
  ratePerDevice   Decimal? @db.Decimal(12, 2)

  // Relations
  transactions       StockTransaction[]
  purchaseOrderItems PurchaseOrderItem[]
  workOrderParts     WorkOrderPart[]
  rateHistory        StockItemRateHistory[]

  // ── Phase 4.2: Soft-delete ──
  // Optional timestamp; when set, the item is considered deleted but kept
  // for audit (preserves transaction history FK references). Existing DELETE
  // endpoints still hard-delete — a follow-up task will migrate them.
  deletedAt DateTime?

  @@index([productCode])
  @@index([category])
  @@index([costType])
  @@index([costModel])
  @@index([isDemo])
  @@index([deletedAt]) // Phase 4.2: soft-delete index
}

// ============================================================
// 17b) StockItemRateHistory — track rate changes over time
//      Lets the cost reports use the rate that was in effect when a
//      transaction occurred, even if the rate has since changed.
//      Each row = one rate snapshot for one StockItem.
// ============================================================
model StockItemRateHistory {
  id          String   @id @default(cuid())
  stockItemId String
  // Cost model that was in effect at the time of this snapshot.
  costModel   String? // 'fixed' | 'per-page' | 'per-hour' | 'monthly' | 'per-device'
  // The rate fields, copied from StockItem at the time of change.
  unitCost           Decimal? @db.Decimal(12, 2)
  ratePerPage        Decimal? @db.Decimal(12, 2)
  ratePerHour        Decimal? @db.Decimal(12, 2)
  ratePerMonth       Decimal? @db.Decimal(12, 2)
  ratePerDevice      Decimal? @db.Decimal(12, 2)
  // Effective date range for this rate.
  effectiveFrom String // ISO date
  effectiveTo   String? // ISO date, null = currently in effect
  // Who changed the rate + why.
  changedBy String?
  reason    String?
  createdAt DateTime @default(now())

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  isDemo    Boolean  @default(false)
  updatedAt DateTime? @updatedAt
  @@index([stockItemId])
  @@index([effectiveFrom])
  @@index([costModel])
}

// ============================================================
// 17) StockTransaction — รับเข้า/เบิกออก
// ============================================================
model StockTransaction {
  id              String   @id @default(cuid())
  txnNumber       String?
  stockItemId     String
  productCode     String?
  productName     String?
  type            String // IN | OUT | ADJUST
  quantity        Int
  unit            String?
  balanceAfter    Int      @default(0)
  reason          String?
  requester       String?
  department      String?
  purpose         String?
  approver        String?
  approvedAt      String?
  // Optional because legacy material rows may be unresolved or quarantined.
  workOrderId     String?
  workOrderNo     String?
  deviceId        String?
  cost            Decimal? @db.Decimal(12, 2)
  unitCost        Decimal? @db.Decimal(12, 2)
  vendor          String?
  receiver        String?
  purchaseOrderNo String?
  txnDate         String
  performedBy     String?
  remark          String?
  sourceKey       String?
  processedFlag   String?
  approvalStatus  String?
  approvalMode    String?
  autoApproveAt   String?
  rejectReason    String?
  // ── WO-PARTS-FLOW (Level 2+): track actual usage vs stock-out ──
  // `quantity` (above) = the integer count that WILL BE DEDUCTED from stock
  //   when the txn is approved (e.g. 1 bottle = qty=1).
  // `usageQuantity` = the FRACTION of the item actually used in this WO
  //   (e.g. 0.33 bottle = filled 3 devices). Lets us compute accurate
  //   cost-per-device + page-yield statistics without tracking ml in real
  //   time. Stored as Decimal(10,3) so 1/3 = 0.333, 1/2 = 0.500, etc.
  //   If null, assume usageQuantity = quantity (1:1 backward compat).
  usageQuantity    Decimal? @db.Decimal(10, 3)
  // Unit hint for the usageQuantity value, so the UI / reports can label it:
  //   'bottle' | 'cartridge' | 'ml' | 'fraction' | null
  usageUnit        String?
  // Source of the consumed material:
  //   'new-bottle' — newly opened from stock (qty=1, stock decremented)
  //   'open-bottle' — used from an already-opened bottle (qty=0, stock untouched)
  //   'new-and-open' — combined (qty=1, usageQuantity=full from new bottle)
  //   null — legacy / not specified (treat as 'new-bottle' for back-compat)
  usageSource      String?
  // For per-hour cost model: actual hours of usage recorded for this txn.
  // Decimal(10,2) so e.g. 2.5 hours = 2.50.
  usageHours       Decimal? @db.Decimal(10, 2)
  // For per-page cost model: actual pages printed/used in this txn.
  // (Typically pulled from the device's MeterReading for the same period.)
  usagePages       Int?
  // For per-device cost model: number of devices serviced in this txn.
  // (Defaults to 1 for WO-scoped parts.)
  usageDevices     Int?
  // Optional idempotency key to prevent duplicate POST /parts retries.
  // If two POSTs arrive with the same clientMutationId within 24h, the
  // second returns the first's created txn instead of duplicating.
  clientMutationId String?
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  device    Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  updatedAt DateTime? @updatedAt
  @@index([stockItemId])
  @@index([type])
  @@index([approvalStatus])
  @@index([isDemo])
  @@index([sourceKey])
  @@index([clientMutationId])
  @@index([workOrderId])
  @@index([workOrderNo])
  // Composite indexes for common query patterns
  @@index([type, createdAt])              // stock-in/out by date
  @@index([stockItemId, type, createdAt]) // transaction history per item
  @@index([approvalStatus, createdAt])    // pending approvals sorted by date
}

// ============================================================
// 18) PurchaseOrder — ใบสั่งซื้อ
// ============================================================
model PurchaseOrder {
  id         String   @id @default(cuid())
  poNumber   String?
  orderDate  String
  supplier   String?
  status     String   @default("open")
  totalValue Decimal? @db.Decimal(12, 2)
  createdBy  String?
  remark     String?
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items PurchaseOrderItem[]

  @@index([status])
  @@index([isDemo])
}

// ============================================================
// 19) PurchaseOrderItem — รายการในใบสั่งซื้อ
// ============================================================
model PurchaseOrderItem {
  id               String   @id @default(cuid())
  purchaseOrderId  String
  stockItemId      String
  quantityOrdered  Int
  quantityReceived Int      @default(0)
  unitPrice        Decimal? @db.Decimal(12, 2)
  totalValue       Decimal? @db.Decimal(12, 2)
  isDemo           Boolean  @default(false)
  createdAt        DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  stockItem     StockItem     @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  updatedAt DateTime? @updatedAt
  @@index([purchaseOrderId])
  @@index([stockItemId])
  @@index([isDemo])
}

// ============================================================
// 20) User — ผู้ใช้
// ============================================================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String?
  name         String?
  role         String   @default("viewer")
  department   String?
  permissions  String? // JSON string
  // Legacy: comma-separated site codes or 'ALL'. Retained during Phase 0
  // dual-read/dual-write migration. Will be retired after UserSiteGrant
  // is fully validated. See Site-Based Access Control Guidance §5.1.
  allowedSites String? // comma-separated or ALL
  active       Boolean  @default(true)
  passwordHash String?
  passwordSalt String?
  remark       String?
  avatarUrl    String?
  phone        String?
  lineUserId   String?
  // OAuth provider subject IDs (for account linking + de-duplication)
  googleSub    String? // Google OAuth sub (stable user identifier)
  appleSub     String? // Apple Sign In sub
  // Registration source: 'local' | 'google_oauth' | 'apple_oauth' | 'line_oauth' | 'demo'
  source       String? @default("local")
  lastLoginAt  String?
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  siteGrants UserSiteGrant[]
  webauthnCredentials WebAuthnCredential[]

  @@index([email])
  @@index([role])
  @@index([isDemo])
  @@index([googleSub])
  @@index([appleSub])
}

// ============================================================
// 20a) Role — Role catalog (Phase 1: authorization foundation)
// ============================================================
// Canonical role definitions stored in DB so they can be audited and
// managed through the admin UI. Seeded from auth-shared.ts ROLE_PERMISSIONS.
//
// `isSystem` marks roles that cannot be deleted (superadmin, admin, etc).
// Custom roles can be created by admins with USER_MANAGE permission.
//
// See: ITAM Shared Platform §4.3
// ============================================================
model Role {
  code        String   @id // superadmin, site_manager, coordinator, technician, requester, viewer
  name        String
  description String?
  isSystem    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grants      UserSiteGrant[]
  permissions RolePermission[]

  isDemo    Boolean  @default(false)
  @@index([active])
}

// ============================================================
// 20a.2) Permission — Permission catalog (Phase 1)
// ============================================================
// Canonical permission definitions. The `code` matches the Permission
// union type in auth-shared.ts so the type system and DB stay in sync.
// `resource` + `action` enable future UI grouping and audit queries.
// ============================================================
model Permission {
  code        String   @id // VIEW_DASHBOARD, WO_CREATE, DEVICE_EDIT, ...
  resource    String // dashboard, device, work_order, stock, ...
  action      String // view, create, edit, delete, assign, ...
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  roles RolePermission[]

  isDemo    Boolean  @default(false)
  updatedAt DateTime? @updatedAt
  @@index([resource])
  @@index([active])
}

// ============================================================
// 20a.3) RolePermission — many-to-many join (Phase 1)
// ============================================================
// Maps which permissions each role has. Seeded from ROLE_PERMISSIONS
// in auth-shared.ts. Changes must be audited.
// ============================================================
model RolePermission {
  roleCode       String
  permissionCode String
  createdAt      DateTime @default(now())

  role       Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleCode, permissionCode])
  isDemo    Boolean  @default(false)
  updatedAt DateTime? @updatedAt
  @@index([permissionCode])
}

// ============================================================
// 20b) UserSiteGrant — Site-level role grants (target design)
// ============================================================
// Allows the same user to have different roles at different Sites
// (e.g. editor at Site A, viewer at Site B). During the transitional
// phase, the auth layer reads from UserSiteGrant first, then falls
// back to User.allowedSites with an audit warning.
//
// `roleCode` now references the Role catalog (Phase 1).
// `validFrom`/`validUntil` support time-bound grants (e.g. temp coverage).
// `createdBy` tracks who issued the grant for audit.
//
// See: ITAM Shared Platform §4.4
// ============================================================
model UserSiteGrant {
  userId     String
  siteCode   String
  roleCode   String    @default("viewer")
  active     Boolean   @default(true)
  validFrom  DateTime?
  validUntil DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleCode], references: [code], onDelete: Restrict)

  @@id([userId, siteCode])
  isDemo    Boolean  @default(false)
  @@index([siteCode, active])
  @@index([userId, active])
  @@index([roleCode, active])
}

// ============================================================
// 21) AuditLog — ประวัติการเปลี่ยนแปลง
// ============================================================
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  summary   String
  detail    String? // JSON string
  actor     String   @default("system")
  // NF-2 FIX: Canonical Site FK for audit entries.
  // Populated by logAudit() when the action is Site-scoped.
  // Null = global action (e.g., LOGIN, AUTH_FALLBACK) or legacy entry
  // that predates this field. Site-scoped queries filter on this column
  // instead of resolving entityId → entity → Site (eliminates N+1).
  siteCode  String?
  // P0-SCHEMA-FIXES: Enhanced attribution fields.
  // userId/ipAddress/userAgent capture who/where/from-what-device the
  // action was taken. Populated by audit-enhanced.ts wrapper (the B4
  // frozen audit.ts is unchanged — values are also stored in detail._meta
  // until audit.ts is refactored to populate these directly).
  userId    String?
  ipAddress String?
  userAgent String?
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  updatedAt DateTime? @updatedAt
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([siteCode, createdAt])
  @@index([userId])
  @@index([isDemo])
}

// ============================================================
// 22) AppSetting — ตั้งค่าแอป
// ============================================================
model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  isDemo    Boolean  @default(false)
  updatedAt DateTime? @updatedAt
  createdAt DateTime @default(now())

  @@index([isDemo])
}

// ============================================================
// 23) AssetNumberPattern — รูปแบบเลขทะเบียน
// ============================================================
model AssetNumberPattern {
  id            String   @id @default(cuid())
  name          String
  pattern       String
  description   String?
  isActive      Boolean  @default(false)
  defaultPrefix String?
  seqPadding    Int      @default(5)
  seqStart      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isDemo    Boolean  @default(false)
  @@index([isActive])
}

// ============================================================
// 23b) WoNumberPattern — รูปแบบเลขใบงาน (เหมือน AssetNumberPattern)
// ============================================================
model WoNumberPattern {
  id            String   @id @default(cuid())
  name          String
  pattern       String // เช่น {prefix}-{seq:4} → PPIT-0001
  description   String?
  isActive      Boolean  @default(false)
  defaultPrefix String? // เช่น PPIT
  seqPadding    Int      @default(4)
  seqStart      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isDemo    Boolean  @default(false)
  @@index([isActive])
}

// ============================================================
// 24) OrganizationProfile — โปรไฟล์องค์กร
// ============================================================
model OrganizationProfile {
  id               String   @id @default(cuid())
  appName          String   @default("ระบบจัดการสินทรัพย์")
  appTagline       String   @default("Asset Management System")
  industryType     String   @default("general")
  logoUrl          String?
  primaryColor     String   @default("#f97316")
  accentColor      String   @default("#0d9488")
  language         String   @default("th")
  timezone         String   @default("Asia/Bangkok")
  currency         String   @default("THB")
  allowExcelImport Boolean  @default(true)

  // ── Phase 3: Financial policy fields ──
  // Fiscal year start month (1-12). Thai gov = 10 (Oct), private = 1 (Jan).
  fiscalYearStartMonth  Int  @default(1)
  // Minimum value to capitalize as fixed asset (฿). Items below this are
  // expensed immediately. Default ฿10,000 (typical Thai private sector).
  defaultCapitalizeThreshold  Decimal? @default(10000) @db.Decimal(12, 2)
  // Terminology: "ครุภัณฑ์" (gov) or "Fixed Asset" (private) or "ทรัพย์สิน"
  assetTerminology  String  @default("ครุภัณฑ์")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  isDemo    Boolean  @default(false)
  @@index([appName])
}

// ============================================================
// 24b) AssetCategory — หมวดหมู่สินทรัพย์ (ค่าเสื่อมราคา/อายุใช้งานมาตรฐาน)
// ============================================================
// แยกจาก Device.type (string อิสระ) เพื่อให้ตั้งค่านโยบายได้ที่ส่วนกลาง
// เจ้าหน้าที่ไม่ต้องกรอกอายุการใช้งานทุกเครื่อง — ดึงจากหมวดหมู่อัตโนมัติ
// ============================================================
model AssetCategory {
  id                 String   @id @default(cuid())
  code               String   @unique // เช่น IT-COMPUTER, IT-PRINTER, IT-NETWORK
  name               String   // ชื่อหมวดหมู่ เช่น "คอมพิวเตอร์"
  // อายุการใช้งานมาตรฐาน (ปี) — ใช้เป็น default ถ้า Device.usefulLife ไม่ได้กรอก
  usefulLifeYears    Int      @default(5)
  // วิธีคำนวณค่าเสื่อมราคา: STRAIGHT_LINE | DECLINING_BALANCE
  depreciationMethod String   @default("STRAIGHT_LINE")
  // อัตราลดต้นทุนทบต้น (เปอร์เซ็นต์ต่อปี) — ใช้เมื่อเลือก DECLINING_BALANCE
  decliningRate      Decimal? @db.Decimal(5, 2) // เช่น 30.00 = 30%/ปี
  // เกณฑ์มูลค่าขั้นต่ำที่ต้องขึ้นทะเบียนเป็นครุภัณฑ์ (฿) — ต่ำกว่านี้ไม่ต้อง
  minCapitalizeValue Decimal? @default(10000) @db.Decimal(12, 2)
  // มูลค่าซากเป็นเปอร์เซ็นต์ของราคาซื้อ (0-100)
  salvageValuePct    Decimal  @default(0) @db.Decimal(5, 2)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  isDemo    Boolean  @default(false)
  @@index([code])
  @@index([active])
}

// ============================================================
// 25) DocumentTemplate — เทมเพลตเอกสาร
// ============================================================
model DocumentTemplate {
  id        String   @id @default(cuid())
  name      String
  type      String
  category  String?
  content   String
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  isFixed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
  isDemo    Boolean  @default(false)
  @@index([type])
}

// ============================================================
// 26) ImportJob — งานนำเข้าข้อมูล
// ============================================================
model ImportJob {
  id            String    @id @default(cuid())
  jobType       String
  fileName      String
  fileType      String    @default("excel")
  status        String    @default("pending")
  totalRows     Int       @default(0)
  processedRows Int       @default(0)
  errorRows     Int       @default(0)
  errors        String?
  uploadedBy    String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  isDemo    Boolean  @default(false)
  updatedAt DateTime? @updatedAt
  @@index([status])
}

// ============================================================
// 27) LineBinding — ผูก LINE user กับผู้แจ้ง
// ============================================================
model LineBinding {
  id              String   @id @default(cuid())
  lineUserId      String   @unique
  lineDisplayName String?
  reporterName    String?
  tel             String?
  employeeCode    String?
  workOrderCount  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  isDemo    Boolean  @default(false)
  @@index([lineUserId])
}

// ============================================================
// 28) Report — รายงานที่บันทึกไว้
// ============================================================
model Report {
  id        String   @id @default(cuid())
  type      String
  title     String
  rangeKey  String?
  filters   String?
  data      String
  format    String   @default("json")
  createdAt DateTime @default(now())
  isDemo    Boolean  @default(false)
  updatedAt DateTime? @updatedAt
  @@index([type])
}

// ============================================================
// 29) PasswordResetToken — token สำหรับ register / reset / invite
//     type: 'register' (Method 2 invite) | 'reset' (forgot password) | 'invite'
//     data: JSON string with { name, phone, department, roleRequest } (for register)
// ============================================================
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String // user email
  token     String   @unique // random UUID
  type      String // 'register' | 'reset' | 'invite'
  data      String? // JSON: { name, phone, department, roleRequest } for registration
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  isDemo    Boolean  @default(false)
  updatedAt DateTime? @updatedAt
  @@index([email])
  @@index([token])
}

// ============================================================
// 30) SyncRun — ประวัติการ sync จาก Legacy Apps Script
//     mode: 'preview' (read-only diff) | 'apply' (write)
//     status: 'pending' | 'running' | 'completed' | 'failed' | 'cancelled'
// ============================================================
model SyncRun {
  id           String        @id @default(cuid())
  source       String // 'services' | 'itam' | 'stock'
  target       String // 'work-order' | 'device' | 'meter' | 'stock-item' | 'stock-txn' | 'purchase-order'
  mode         String // 'preview' | 'apply'
  status       String // 'pending' | 'running' | 'completed' | 'failed' | 'cancelled'
  totalRows    Int           @default(0)
  createRows   Int           @default(0)
  updateRows   Int           @default(0)
  skipRows     Int           @default(0)
  errorRows    Int           @default(0)
  startedAt    DateTime      @default(now())
  completedAt  DateTime?
  durationMs   Int?
  triggeredBy  String // user email
  siteScope    String?
  errorMessage String?
  retryOf      String?
  sourceCursor String?
  attempts     Int           @default(1)
  p2034Count   Int           @default(0)
  items        SyncRunItem[]
  createdAt    DateTime      @default(now())

  isDemo    Boolean  @default(false)
  updatedAt DateTime? @updatedAt
  @@index([source, target, status])
  @@index([triggeredBy])
  @@index([siteScope, createdAt])
  @@index([status, createdAt])
}

// ============================================================
// 31) SyncRunItem — diff รายแถวจากการ sync
//     action: 'create' | 'update' | 'skip' | 'error'
//     status: 'pending' | 'applied' | 'skipped' | 'error'
// ============================================================
model SyncRunItem {
  id              String    @id @default(cuid())
  syncRunId       String
  syncRun         SyncRun   @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  externalKey     String
  action          String // 'create' | 'update' | 'skip' | 'error'
  before          Json?
  after           Json?
  expectedVersion Int?
  expectedExists  Boolean   @default(false)
  status          String // 'pending' | 'applied' | 'skipped' | 'error'
  errorMessage    String?
  entityId        String?
  entityType      String?
  processedAt     DateTime?

  isDemo    Boolean  @default(false)
  updatedAt DateTime? @updatedAt
  @@index([syncRunId, action])
  @@index([externalKey])
  @@index([syncRunId, status])
  createdAt DateTime @default(now())
}

// ============================================================
// 23) PMSchedule — ตารางงานบำรุงรักษาป้องกัน (Preventive Maintenance)
// ============================================================
model PMSchedule {
  id           String   @id @default(cuid())
  scheduleNo   String?  @unique
  title        String
  description  String?
  frequency    String   @default("monthly")
  intervalDays Int?
  dayOfMonth   Int?
  weekday      String?
  startMonth   Int?
  deviceType   String?
  site         String?
  building     String?
  floor        String?
  department   String?
  deviceId     String?
  checklist    String?
  active       Boolean  @default(true)
  startDate    String?
  lastRunDate  String?
  nextRunDate  String?
  autoCreateWO Boolean  @default(false)
  assignedTo   String?
  createdBy    String?
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  device     Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  executions PMExecution[]

  // ── Phase 4.2: Soft-delete ──
  // Optional timestamp; when set, the schedule is considered deleted but
  // kept for audit (preserves PMExecution FK references). Existing DELETE
  // endpoints still hard-delete — a follow-up task will migrate them.
  deletedAt DateTime?

  @@index([active, nextRunDate])
  @@index([frequency])
  @@index([site])
  @@index([deviceType])
  @@index([isDemo])
  @@index([deletedAt]) // Phase 4.2: soft-delete index
}

// ============================================================
// 24) PMExecution — ผลการทำ PM แต่ละครั้ง
// ============================================================
model PMExecution {
  id              String   @id @default(cuid())
  scheduleId      String
  workOrderId     String?
  scheduledDate   String
  executedDate    String?
  status          String   @default("PENDING")
  checklistResult String?
  remark          String?
  performedBy     String?
  images          String?
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  schedule PMSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, scheduledDate])
  @@index([status])
  @@index([scheduledDate])
  @@index([isDemo])
}

// ============================================================
// 30) WebAuthnCredential — ลายนิ้วมือ / Face ID / Touch ID / Passkey
// ============================================================
// รองรับ WebAuthn (FIDO2) login — ผู้ใช้ลงทะเบียน biometric จากอุปกรณ์
// แล้ว login ด้วย fingerprint แทน password ได้.
//
// Supports: Touch ID (macOS/iOS), Face ID (iOS), Windows Hello,
// Android fingerprint, hardware security keys (YubiKey).
// ============================================================
model WebAuthnCredential {
  id              String   @id // base64url credential ID (สำหรับ lookup)
  userId          String
  publicKey       Bytes    // COSE public key
  counter         Int      @default(0) // signature counter (replay protection)
  deviceType      String?  // 'touchid' | 'faceid' | 'windows-hello' | 'android-fingerprint' | 'security-key'
  transports      String?  // comma-separated: 'internal,hybrid,usb,nfc,ble'
  name            String?  // ชื่อที่ผู้ใช้ตั้งให้ device (e.g. "iPhone ของผม")
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  isDemo    Boolean  @default(false)
  updatedAt DateTime? @updatedAt
  @@index([userId])
}

// ============================================================
// 31) DeviceAccessory — อุปกรณ์ต่อพ่วง (Accessories/Peripherals)
// ============================================================
// อุปกรณ์ที่ต่อพ่วงกับอุปกรณ์หลัก เช่น:
//   - คีย์บอร์ด, เมาส์, จอภาพ, สแกนเนอร์เสริม
//   - สายแลน, อะแดปเตอร์, UPS, USB hub
//   - หัวพิมพ์เสริม, ถาดกระดาษเสริม
//
// 1 อุปกรณ์หลัก → ได้หลายอุปกรณ์ต่อพ่วง
// สามารถย้ายระหว่างอุปกรณ์ได้ (change parentDeviceId)
// ============================================================
model DeviceAccessory {
  id              String   @id @default(cuid())
  parentDeviceId  String   // FK → Device.id (อุปกรณ์หลักที่ต่อพ่วงอยู่)
  accessoryType   String   // ประเภท: KEYBOARD | MOUSE | MONITOR | SCANNER | CABLE | ADAPTER | UPS | HUB | PRINTHEAD | TRAY | OTHER
  brand           String?  // ยี่ห้อ
  model           String?  // รุ่น
  serialNumber    String?  // หมายเลขซีเรียล
  status          String   @default("Active") // Active | Inactive | In Repair | Disposed
  installedDate   String?  // วันที่ติดตั้ง (ISO date)
  removedDate     String?  // วันที่ถอดออก (ถ้ามี)
  remark          String?  // หมายเหตุ
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parentDevice    Device   @relation(fields: [parentDeviceId], references: [id], onDelete: Cascade)

  @@index([parentDeviceId])
  @@index([accessoryType])
  @@index([status])
  @@index([isDemo])
}

// ============================================================
// 32) PublicReporter — ผู้แจ้งซ่อมจาก QR สาธารณะ
// ============================================================
// บุคคลภายนอกที่สแกน QR บนอุปกรณ์แล้วแจ้งซ่อม โดยไม่มี account พนักงาน
// ระบุตัวตนได้ 3 ระดับ:
//   - Tier 1: LINE Login + phone scope → phoneVerified=true (อัตโนมัติ)
//   - Tier 2: LINE Login ไม่มี phone → มี lineUserId แต่ไม่รู้เบอร์ (staff โทร verify)
//   - Tier 3: กรอกเบอร์+ชื่อ manual → phoneVerified=false (staff โทร verify)
//
// Unique key: (siteCode, phone) และ (siteCode, lineUserId)
// → คนจากสาขา A ไม่ปนกับสาขา B ถ้าแจ้งหลายสาขา
//
// Anti-spam:
//   - isBlocked: staff แบนเบอร์ได้
//   - reportCount/lastReportAt: ตรวจ anomaly แจ้งเยอะผิดปกติ
// ============================================================
model PublicReporter {
  id              String   @id @default(cuid())
  siteCode        String   // สาขาที่แจ้ง (PPIT, UDH, NKP, MECUD...)
  // Anonymous identification (Tier 3)
  phone           String?  // เบอร์มือถือ (Thai: 08X-XXX-XXXX)
  name            String?  // ชื่อ-สกุล (ผู้แจ้ง manual)
  email           String?
  // LINE identification (Tier 1+2)
  lineUserId      String?  // LINE userId (sub claim — unique per LINE Login channel)
  lineDisplayName String?
  linePictureUrl  String?
  lineScopePhone  String?  // เบอร์จาก LINE phone scope (ถ้ามี)
  // Verification status
  phoneVerified   Boolean  @default(false)  // true เมื่อ verify ผ่าน LINE phone scope หรือ OTP
  verifiedAt      DateTime?
  verifiedMethod  String?  // 'line_phone_scope' | 'manual_call' | 'otp_sms' (future)
  // Anti-spam / moderation
  isBlocked       Boolean  @default(false)
  blockedReason   String?
  blockedAt       DateTime?
  blockedBy       String?  // staff user id ที่แบน
  reportCount     Int      @default(0)
  lastReportAt    DateTime?
  // Metadata
  defaultDeviceId String?  // อุปกรณ์ที่แจ้งล่าสุด (hint สำหรับ UI)
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  siteAttribute   SiteAttribute? @relation(fields: [siteCode], references: [SiteCode], onDelete: Restrict)
  workOrders      WorkOrder[]

  @@unique([siteCode, phone])
  @@unique([siteCode, lineUserId])
  @@index([siteCode])
  @@index([phone])
  @@index([lineUserId])
  @@index([isBlocked])
  @@index([isDemo])
}

// ============================================================
// 33) StockCountSession — รอบนับสต็อก/ตรวจนับครุภัณฑ์ (Phase 5)
// ============================================================
// ใช้สำหรับนับสต็อกจริง (Stock Take) หรือตรวจนับครุภัณฑ์ (Asset Verification)
// scope: STOCK_ITEM = นับสินค้าคงคลัง, DEVICE = ตรวจนับอุปกรณ์
// ============================================================
model StockCountSession {
  id          String   @id @default(cuid())
  name        String   // ชื่อรอบนับ เช่น "นับสต็อกประจำเดือน ก.ย. 2026"
  scope       String   @default("STOCK_ITEM") // STOCK_ITEM | DEVICE
  siteCode    String?  // สาขาที่นับ (null = ทุกสาขา)
  status      String   @default("OPEN") // OPEN | CLOSED | CANCELLED
  startedAt   DateTime @default(now())
  closedAt    DateTime?
  createdBy   String?
  note        String?
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       StockCountItem[]

  @@index([scope])
  @@index([status])
  @@index([siteCode])
  @@index([isDemo])
}

model StockCountItem {
  id              String   @id @default(cuid())
  sessionId       String
  session         StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Target: either a StockItem (scope=STOCK_ITEM) or a Device (scope=DEVICE)
  targetId        String   // FK → StockItem.id หรือ Device.id (ไม่ใช้ relation FK เพราะ scope เปลี่ยนได้)
  targetCode      String?  // productCode หรือ assetCode (เก็บ snapshot)

  // Expected values (snapshot จากระบบตอนเริ่มรอบ)
  expectedQty     Int?     // สำหรับ STOCK_ITEM
  expectedLocation String? // สำหรับ DEVICE (building/floor/room)

  // Counted values (กรอกโดยผู้นับ)
  countedQty      Int?     // จำนวนจริงที่นับได้
  countedLocation String?  // ตำแหน่งจริงที่พบ (สำหรับ DEVICE)
  countedBy       String?
  countedAt       DateTime?

  // Result
  variance        Int?     // ผลต่าง (counted - expected) สำหรับ STOCK_ITEM
  status          String   @default("PENDING") // PENDING | COUNTED | NOT_FOUND | WRONG_LOCATION
  note            String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sessionId])
  @@index([targetId])
  @@index([status])
}
