// ============================================================
// 2) MeterReading — การจดมิเตอร์
// ============================================================
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1) Device — อุปกรณ์ IT (เครื่องพิมพ์, สแกนเนอร์, คอมพิวเตอร์, ...)
// ============================================================
model Device {
  id              String   @id @default(cuid())
  assetCode       String   @unique // asset_no — เลขสินทรัพย์รวม ห้ามแก้ไข
  name            String // ชื่ออุปกรณ์
  brand           String
  model           String
  type            String // ประเภท: PRINTER | SCANNER | COMPUTER | NETWORK | OTHER
  serialNumber    String? // serial
  status          String   @default("Active")
  site            String // สาขา/ที่ตั้ง
  department      String?
  departmentCode  String?
  parentRef       String?
  assetSiteCode   String? // asset_site_code — รหัสประจำ Site (SITE-NNNNN)
  displayLabel    String? // ป้ายแสดงผลที่ผู้ใช้กำหนดเอง (display label)
  location        String?
  building        String?
  floor           String?
  room            String?
  purchaseDate    String? // ISO date
  purchasePrice   Decimal? @db.Decimal(12, 2)
  salvageValue    Decimal? @default(0) @db.Decimal(12, 2)
  usefulLife      Int?
  warrantyMonths  Int      @default(12)
  warrantyEnd     String?
  vendor          String?
  contractNo      String?
  uninstallDate   String?
  meterRequired   Boolean  @default(false)
  meterMode       String? // TOTAL | BW_COLOR
  lastMeterBw     Int      @default(0)
  lastMeterColor  Int      @default(0)
  ip              String?
  mac             String?
  remoteId        String?
  currentAssignee String?
  remark          String?
  costCenter      String?
  deviceGroup     String?
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       String?  @default("System")

  // ── Device Set / Parent-Child (Task ID 9, Phase 2) ──
  // Lets devices be grouped as a "set": e.g. a printer (parent) with
  // its UPS, network card, paper tray (children). Children may or may not
  // have their own assetCode (if not, use a generated placeholder).
  // `parentDeviceId` is a self-FK; onDelete: SetNull so deleting a parent
  // doesn't cascade-delete children (they become orphaned but kept).
  parentDeviceId String?
  parentDevice   Device?  @relation("DeviceSetChildren", fields: [parentDeviceId], references: [id], onDelete: SetNull)
  childDevices   Device[] @relation("DeviceSetChildren")
  setLabel       String? // ชื่อชุด เช่น "ชุดเครื่องพิมพ์ห้องจ่ายยา"
  setPosition    Int? // ลำดับในชุด (1, 2, 3, …)

  // Relations (other models reference Device via deviceId)
  meterReadings     MeterReading[]
  transfers         DeviceTransfer[]
  assignments       Assignment[]
  maintenanceLogs   MaintenanceLog[]
  workOrders        WorkOrder[]
  stockTransactions StockTransaction[]
  pmSchedules       PMSchedule[]
  accessories       DeviceAccessory[]

  @@index([parentDeviceId])
  @@index([status])
  @@index([site])
  @@index([serialNumber])
}

model MeterReading {
  id                      String   @id @default(cuid())
  readingId               String?  @unique
  deviceId                String
  assetCode               String? // asset_no — สำหรับ CSV import lookup
  readingDate             String // ISO date
  readingMonth            String? // YYYY-MM
  meterBw                 Int      @default(0)
  meterColor              Int      @default(0)
  pagesBw                 Int      @default(0)
  pagesColor              Int      @default(0)
  prevMeterBw             Int      @default(0)
  prevMeterColor          Int      @default(0)
  // Snapshot of Device.meterMode at the time of this reading (TOTAL | BW_COLOR | null).
  // Lets us reconstruct the meter configuration when the reading was taken, so
  // mode-switch detection works even after device.meterMode has changed.
  meterMode               String? // TOTAL | BW_COLOR
  // Snapshot of the previous reading's meterMode — makes mode transitions
  // explicit and queryable (e.g. "show me all TOTAL→BW_COLOR transitions").
  prevMeterMode           String?
  readingType             String? // MONTHLY | INITIAL | FINAL | RESET | CHECKOUT | SEND_REPAIR | RETURN | TRANSFER
  readBy                  String?
  remark                  String?
  locationAtReading       String?
  siteAtReading           String?
  buildingAtReading       String?
  floorAtReading          String?
  departmentAtReading     String?
  departmentCodeAtReading String?
  eventType               String?
  eventId                 String?
  isDemo                  Boolean  @default(false)
  createdAt               DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([readingMonth])
  @@index([isDemo])
  // Composite indexes for common query patterns
  @@index([deviceId, readingMonth])       // meter readings per device per month
  @@index([readingType, readingDate])     // filter by type + date range
  @@index([readingDate])                  // date range queries (dashboard)
  @@index([deviceId, readingDate])        // latest reading per device
}

// ============================================================
// 3) Cycle — รอบจดมิเตอร์
//    `site` is optional — null means "all sites" (a global cycle).
//    When set, the cycle is scoped to that site code (e.g. "UDH").
// ============================================================
model Cycle {
  id        String   @id @default(cuid())
  name      String
  startDate String
  endDate   String
  status    String   @default("active")
  site      String? // nullable — null = all sites (global cycle)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([site])
  @@index([updatedAt])
}

// ============================================================
// 4) DeviceTransfer — ประวัติการย้าย
// ============================================================
model DeviceTransfer {
  id                 String   @id @default(cuid())
  logId              String?  @unique
  deviceId           String
  assetCode          String? // Asset_No
  moveDate           String?
  action             String? // TRANSFER | TRANSFER_SITE | STATUS_CHANGE | STATUS_AND_TRANSFER | TRANSFER_BY_LIFECYCLE
  fromStatus         String?
  toStatus           String?
  fromSite           String?
  fromAssetSiteCode  String?
  fromBuilding       String?
  fromFloor          String?
  fromDepartment     String?
  fromDepartmentCode String?
  fromLocation       String?
  toSite             String
  toAssetSiteCode    String?
  toBuilding         String?
  toFloor            String?
  toDepartment       String?
  toDepartmentCode   String?
  toLocation         String?
  meterReadingId     String?
  movedBy            String?
  remark             String?
  transferDate       String
  reason             String?
  createdAt          DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([toSite])
}

// ============================================================
// 5) Assignment — การมอบหมายอุปกรณ์
// ============================================================
model Assignment {
  id                 String   @id @default(cuid())
  assignmentId       String?  @unique
  deviceId           String
  assignee           String
  assigneeRole       String?
  department         String?
  checkoutDate       String
  expectedReturnDate String?
  actualReturnDate   String?
  status             String   @default("active")
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([assignee])
}

// ============================================================
// 6) MaintenanceLog — ประวัติซ่อมบำรุง
// ============================================================
model MaintenanceLog {
  id           String   @id @default(cuid())
  logId        String?  @unique
  deviceId     String
  type         String // repair | maintenance | inspection | upgrade
  status       String   @default("open")
  startDate    String
  endDate      String?
  cost         Decimal? @db.Decimal(12, 2)
  vendor       String?
  description  String
  resolvedNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
}

// ============================================================
// 7) WorkOrder — ใบงานแจ้งซ่อม
// ============================================================
model WorkOrder {
  id               String    @id @default(cuid())
  woNumber         String?   @unique
  // Legacy source identifier; immutable for traceability when supplied by imports.
  legacyJobNo      String?   @map("legacy_job_no")
  // New ITAM-NextJS identifier; woNumber remains as the compatibility display field.
  systemJobNo      String?   @unique @map("system_job_no")
  requestId        String?   @unique
  subject          String
  building         String?
  location         String?
  details          String?
  priority         String    @default("ปกติ")
  reporterName     String?
  reporterEmail    String?
  tel              String?
  employeeCode     String?
  submissionSource String    @default("guest")
  trackable        Boolean   @default(false)
  lineUserId       String?
  lineMessageId    String?   @unique
  printTemplateId  String?
  externalMeta     String?
  picBefore        String?
  picOnsite        String?
  picAfter         String?
  status           String    @default("PENDING")
  acceptStatus     String?
  assignedTo       String?
  assignedBy       String?
  assignedAt       DateTime?
  assignmentNote   String?
  detailsAdmin     String?
  dateAdmin        String?
  resolution       String?
  resolutionGroup  String?
  editUnlockActive Boolean   @default(false)
  editUnlockBy     String?
  editUnlockAt     DateTime?
  editUnlockNote   String?
  workCompletedAt  DateTime?
  closedAt         DateTime?
  canceledAt       DateTime?
  cancelReason     String?
  deviceId         String?
  isDemo           Boolean   @default(false)
  isSpecialFee     Boolean   @default(false) // งานพิเศษ (มีค่าใช้จ่าย) — แอปอื่นดึงผ่าน API
  // ── Site-based access control (Phase 0: transitional) ──
  // Direct Site reference so work orders without a device can still be
  // scoped. For work orders with a device, the server derives siteCode
  // from Device.site on create/update. Null = external/unassigned (uses
  // a separate authorization flow — never means "all sites").
  // See: Site-Based Access Control Guidance for ITAM-NextJS.md §5.1
  siteCode         String?
  // B4 FIX: Optimistic concurrency version field.
  // Incremented on every update. Callers can send `expectedVersion` in
  // PUT/PATCH to detect concurrent modification (409 Conflict).
  // Used with serializable transaction for device reassignment.
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  device   Device?            @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  messages WorkOrderMessage[]
  reviews  WorkOrderReview[]
  images   WorkOrderImage[]
  parts    WorkOrderPart[]

  @@index([status])
  @@index([legacyJobNo])
  @@index([assignedTo])
  @@index([deviceId])
  @@index([isDemo])
  @@index([isSpecialFee])
  @@index([siteCode, status, createdAt])
  @@index([version])
}

// ============================================================
// 8) WorkOrderMessage — แชทในใบงาน
// ============================================================
model WorkOrderMessage {
  id          String   @id @default(cuid())
  workOrderId String
  message     String
  author      String?
  authorRole  String?
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

// ============================================================
// 9) WorkOrderReview — คะแนนความพึงพอใจ
// ============================================================
model WorkOrderReview {
  id          String   @id @default(cuid())
  workOrderId String
  rating      Int
  comment     String?
  reviewedBy  String?
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

// ============================================================
// 10) WorkOrderImage — รูปภาพในใบงาน (หลายรูปต่อขั้นตอน)
// ============================================================
model WorkOrderImage {
  id          String   @id @default(cuid())
  workOrderId String
  stage       String // before | onsite | after
  image_data  String
  fileName    String?
  uploadedBy  String?
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([stage])
  @@map("work_order_images")
}

// ============================================================
// 10b) WorkOrderPart — คำขออะไหล่ในใบงาน (Task ID: P0-SCHEMA-FIXES)
//     Referenced by CompleteDialog Step 2 (work-orders-page.tsx).
//     Tracks each part requested against a WorkOrder, with optional
//     StockItem linkage and an approval workflow (PENDING -> APPROVED/REJECTED).
// ============================================================
model WorkOrderPart {
  id          String     @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  stockItemId String?
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id])
  productCode String
  productName String
  quantity    Int
  unitCost    Decimal?   @db.Decimal(12, 2)
  totalCost   Decimal?   @db.Decimal(12, 2)
  status      String     @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedBy String?
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([workOrderId])
  @@index([status])
  @@index([stockItemId])
}

// ============================================================
// 11) LicenseRecord — ลิขสิทธิ์ซอฟต์แวร์
// ============================================================
model LicenseRecord {
  id          String   @id @default(cuid())
  License_ID  String?
  Asset_No    String? // links to Device.assetCode
  Software    String
  LicenseType String? // OEM | Volume | Retail | Subscription | Open License
  License_Key String?
  Quantity    Int      @default(1)
  Expiry_Date String?
  Remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([Asset_No])
  @@map("license_records")
}

// ============================================================
// 12) SiteAttribute — ข้อมูลสาขา + อัตราค่ากระดาษ
//     Source: sheet "Site_Attributes"
// ============================================================
model SiteAttribute {
  id             String   @id @default(cuid())
  SiteCode       String   @unique // เช่น UDH, NKP, MECUD, PPIT
  SiteName       String? // เช่น โรงพยาบาลศูนย์อุดรธานี
  LineOA         String? // LINE OA ID/Token
  Hotline        String? // เบอร์ติดต่อ
  PaperRateBW    Decimal? @default(0.5) @db.Decimal(12, 2) // ฿/แผ่น ขาวดำ
  PaperRateColor Decimal? @default(2.0) @db.Decimal(12, 2) // ฿/แผ่น สี
  TelegramChatId String?  @map("TelegramChatId") // Telegram chat ID สำหรับสาขา
  EmailAddress   String?  @map("EmailAddress") // อีเมลสาขาสำหรับรับแจ้งเตือน
  isDemo         Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("site_attributes")
}

// ============================================================
// 13) Site — สาขา (legacy, ใช้คู่กับ SiteAttribute)
// ============================================================
model Site {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
}

// ============================================================
// 14) SiteRate — อัตราค่ากระดาษต่อสาขา (legacy)
// ============================================================
model SiteRate {
  id        String   @id @default(cuid())
  siteCode  String
  bwRate    Decimal  @default(0.5) @db.Decimal(12, 2)
  colorRate Decimal  @default(2.0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteCode])
}

// ============================================================
// 15) MasterItem — ข้อมูลมาตรฐาน (Brand, Type, Model, Department, Status, DeviceGroup, Site)
// ============================================================
model MasterItem {
  id           String   @id @default(cuid())
  category     String // category column from Excel
  code         String // code column (DC-001, DEP-001, IT-PRN, etc.)
  label        String // label column (display name)
  brand        String? // brand (for DeviceClassification)
  model        String? // model (for DeviceClassification)
  deviceType   String? // deviceType (for DeviceClassification)
  parentRef    String? // parentRef (Affiliation label for Department, IT-PRN for RepairRequest, etc.)
  displayLabel String? // displayLabel column
  siteCode     String? // siteCode column (ALL, UDH, etc.)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([code])
}

// ============================================================
// 16) StockItem — สินค้าในสต็อก
// ============================================================
model StockItem {
  id                String   @id @default(cuid())
  productCode       String   @unique
  productName       String
  category          String?
  brand             String?
  model             String?
  unit              String   @default("ชิ้น")
  quantity          Int      @default(0)
  minQuantity       Int      @default(0)
  maxQuantity       Int      @default(0)
  unitCost          Decimal? @db.Decimal(12, 2)
  totalValue        Decimal? @db.Decimal(12, 2)
  location          String?
  site              String?
  compatibleDevices String?
  remark            String?
  active            Boolean  @default(true)
  isDemo            Boolean  @default(false)
  lastUpdated       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // ── Cost Analytics (COST-ANALYTICS-SPEC.md Phase 1) ──
  costType           String?
  yieldPerPage       Int?
  depreciationMethod String?
  usefulLifeMonths   Int?
  usefulLifePages    Int?

  // ── WO-PARTS-FLOW Level 2+: flexible cost model + usage defaults ──
  // The cost model determines how this item is charged in WO parts requests.
  //   'fixed'      — one-time cost per unit (default, backward compat)
  //   'per-page'   — cost = pages printed × ratePerPage (e.g. paper contracts)
  //   'per-hour'   — cost = hours used × ratePerHour (e.g. rental equipment)
  //   'monthly'    — flat monthly fee, charged regardless of usage (e.g. service contracts)
  //   'per-device' — cost per device serviced (e.g. visit fee)
  costModel          String? // 'fixed' | 'per-page' | 'per-hour' | 'monthly' | 'per-device'
  // Default usage assumptions used by the parts picker UI to pre-fill
  // usageQuantity when this item is added to a WO. Saves the technician
  // from having to guess. Can be overridden per-request.
  //   expectedDevicesPerUnit — e.g. ink bottle fills 3 devices → 1/3 = 0.333
  //   expectedHoursPerUnit   — e.g. rental item lasts 8 hours per charge → 8
  //   expectedPagesPerUnit   — e.g. toner cartridge yields 1500 pages → 1500
  expectedDevicesPerUnit Int?
  expectedHoursPerUnit   Int?
  expectedPagesPerUnit   Int?
  // The rate used for non-'fixed' cost models:
  //   per-page  → ratePerPage (฿ per page)
  //   per-hour  → ratePerHour (฿ per hour)
  //   monthly   → ratePerMonth (฿ per month)
  //   per-device → ratePerDevice (฿ per device serviced)
  // For 'fixed' model, the existing unitCost field is used.
  ratePerPage     Decimal? @db.Decimal(12, 2)
  ratePerHour     Decimal? @db.Decimal(12, 2)
  ratePerMonth    Decimal? @db.Decimal(12, 2)
  ratePerDevice   Decimal? @db.Decimal(12, 2)

  // Relations
  transactions       StockTransaction[]
  purchaseOrderItems PurchaseOrderItem[]
  workOrderParts     WorkOrderPart[]
  rateHistory        StockItemRateHistory[]

  @@index([productCode])
  @@index([category])
  @@index([costType])
  @@index([costModel])
  @@index([isDemo])
}

// ============================================================
// 17b) StockItemRateHistory — track rate changes over time
//      Lets the cost reports use the rate that was in effect when a
//      transaction occurred, even if the rate has since changed.
//      Each row = one rate snapshot for one StockItem.
// ============================================================
model StockItemRateHistory {
  id          String   @id @default(cuid())
  stockItemId String
  // Cost model that was in effect at the time of this snapshot.
  costModel   String? // 'fixed' | 'per-page' | 'per-hour' | 'monthly' | 'per-device'
  // The rate fields, copied from StockItem at the time of change.
  unitCost           Decimal? @db.Decimal(12, 2)
  ratePerPage        Decimal? @db.Decimal(12, 2)
  ratePerHour        Decimal? @db.Decimal(12, 2)
  ratePerMonth       Decimal? @db.Decimal(12, 2)
  ratePerDevice      Decimal? @db.Decimal(12, 2)
  // Effective date range for this rate.
  effectiveFrom String // ISO date
  effectiveTo   String? // ISO date, null = currently in effect
  // Who changed the rate + why.
  changedBy String?
  reason    String?
  createdAt DateTime @default(now())

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([stockItemId])
  @@index([effectiveFrom])
  @@index([costModel])
}

// ============================================================
// 17) StockTransaction — รับเข้า/เบิกออก
// ============================================================
model StockTransaction {
  id              String   @id @default(cuid())
  txnNumber       String?
  stockItemId     String
  productCode     String?
  productName     String?
  type            String // IN | OUT | ADJUST
  quantity        Int
  unit            String?
  balanceAfter    Int      @default(0)
  reason          String?
  requester       String?
  department      String?
  purpose         String?
  approver        String?
  approvedAt      String?
  // Optional because legacy material rows may be unresolved or quarantined.
  workOrderId     String?
  workOrderNo     String?
  deviceId        String?
  cost            Decimal? @db.Decimal(12, 2)
  unitCost        Decimal? @db.Decimal(12, 2)
  vendor          String?
  receiver        String?
  purchaseOrderNo String?
  txnDate         String
  performedBy     String?
  remark          String?
  sourceKey       String?
  processedFlag   String?
  approvalStatus  String?
  approvalMode    String?
  autoApproveAt   String?
  rejectReason    String?
  // ── WO-PARTS-FLOW (Level 2+): track actual usage vs stock-out ──
  // `quantity` (above) = the integer count that WILL BE DEDUCTED from stock
  //   when the txn is approved (e.g. 1 bottle = qty=1).
  // `usageQuantity` = the FRACTION of the item actually used in this WO
  //   (e.g. 0.33 bottle = filled 3 devices). Lets us compute accurate
  //   cost-per-device + page-yield statistics without tracking ml in real
  //   time. Stored as Decimal(10,3) so 1/3 = 0.333, 1/2 = 0.500, etc.
  //   If null, assume usageQuantity = quantity (1:1 backward compat).
  usageQuantity    Decimal? @db.Decimal(10, 3)
  // Unit hint for the usageQuantity value, so the UI / reports can label it:
  //   'bottle' | 'cartridge' | 'ml' | 'fraction' | null
  usageUnit        String?
  // Source of the consumed material:
  //   'new-bottle' — newly opened from stock (qty=1, stock decremented)
  //   'open-bottle' — used from an already-opened bottle (qty=0, stock untouched)
  //   'new-and-open' — combined (qty=1, usageQuantity=full from new bottle)
  //   null — legacy / not specified (treat as 'new-bottle' for back-compat)
  usageSource      String?
  // For per-hour cost model: actual hours of usage recorded for this txn.
  // Decimal(10,2) so e.g. 2.5 hours = 2.50.
  usageHours       Decimal? @db.Decimal(10, 2)
  // For per-page cost model: actual pages printed/used in this txn.
  // (Typically pulled from the device's MeterReading for the same period.)
  usagePages       Int?
  // For per-device cost model: number of devices serviced in this txn.
  // (Defaults to 1 for WO-scoped parts.)
  usageDevices     Int?
  // Optional idempotency key to prevent duplicate POST /parts retries.
  // If two POSTs arrive with the same clientMutationId within 24h, the
  // second returns the first's created txn instead of duplicating.
  clientMutationId String?
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  device    Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([stockItemId])
  @@index([type])
  @@index([approvalStatus])
  @@index([isDemo])
  @@index([sourceKey])
  @@index([clientMutationId])
  @@index([workOrderId])
  @@index([workOrderNo])
  // Composite indexes for common query patterns
  @@index([type, createdAt])              // stock-in/out by date
  @@index([stockItemId, type, createdAt]) // transaction history per item
  @@index([approvalStatus, createdAt])    // pending approvals sorted by date
}

// ============================================================
// 18) PurchaseOrder — ใบสั่งซื้อ
// ============================================================
model PurchaseOrder {
  id         String   @id @default(cuid())
  poNumber   String?
  orderDate  String
  supplier   String?
  status     String   @default("open")
  totalValue Decimal? @db.Decimal(12, 2)
  createdBy  String?
  remark     String?
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items PurchaseOrderItem[]

  @@index([status])
  @@index([isDemo])
}

// ============================================================
// 19) PurchaseOrderItem — รายการในใบสั่งซื้อ
// ============================================================
model PurchaseOrderItem {
  id               String   @id @default(cuid())
  purchaseOrderId  String
  stockItemId      String
  quantityOrdered  Int
  quantityReceived Int      @default(0)
  unitPrice        Decimal? @db.Decimal(12, 2)
  totalValue       Decimal? @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  stockItem     StockItem     @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
}

// ============================================================
// 20) User — ผู้ใช้
// ============================================================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String?
  name         String?
  role         String   @default("viewer")
  department   String?
  permissions  String? // JSON string
  // Legacy: comma-separated site codes or 'ALL'. Retained during Phase 0
  // dual-read/dual-write migration. Will be retired after UserSiteGrant
  // is fully validated. See Site-Based Access Control Guidance §5.1.
  allowedSites String? // comma-separated or ALL
  active       Boolean  @default(true)
  passwordHash String?
  passwordSalt String?
  remark       String?
  avatarUrl    String?
  phone        String?
  lineUserId   String?
  // OAuth provider subject IDs (for account linking + de-duplication)
  googleSub    String? // Google OAuth sub (stable user identifier)
  appleSub     String? // Apple Sign In sub
  // Registration source: 'local' | 'google_oauth' | 'apple_oauth' | 'line_oauth' | 'demo'
  source       String? @default("local")
  lastLoginAt  String?
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  siteGrants UserSiteGrant[]
  webauthnCredentials WebAuthnCredential[]

  @@index([email])
  @@index([role])
  @@index([isDemo])
  @@index([googleSub])
  @@index([appleSub])
}

// ============================================================
// 20a) Role — Role catalog (Phase 1: authorization foundation)
// ============================================================
// Canonical role definitions stored in DB so they can be audited and
// managed through the admin UI. Seeded from auth-shared.ts ROLE_PERMISSIONS.
//
// `isSystem` marks roles that cannot be deleted (superadmin, admin, etc).
// Custom roles can be created by admins with USER_MANAGE permission.
//
// See: ITAM Shared Platform §4.3
// ============================================================
model Role {
  code        String   @id // superadmin, site_manager, coordinator, technician, requester, viewer
  name        String
  description String?
  isSystem    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grants      UserSiteGrant[]
  permissions RolePermission[]
}

// ============================================================
// 20a.2) Permission — Permission catalog (Phase 1)
// ============================================================
// Canonical permission definitions. The `code` matches the Permission
// union type in auth-shared.ts so the type system and DB stay in sync.
// `resource` + `action` enable future UI grouping and audit queries.
// ============================================================
model Permission {
  code        String   @id // VIEW_DASHBOARD, WO_CREATE, DEVICE_EDIT, ...
  resource    String // dashboard, device, work_order, stock, ...
  action      String // view, create, edit, delete, assign, ...
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

// ============================================================
// 20a.3) RolePermission — many-to-many join (Phase 1)
// ============================================================
// Maps which permissions each role has. Seeded from ROLE_PERMISSIONS
// in auth-shared.ts. Changes must be audited.
// ============================================================
model RolePermission {
  roleCode       String
  permissionCode String
  createdAt      DateTime @default(now())

  role       Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleCode, permissionCode])
  @@index([permissionCode])
}

// ============================================================
// 20b) UserSiteGrant — Site-level role grants (target design)
// ============================================================
// Allows the same user to have different roles at different Sites
// (e.g. editor at Site A, viewer at Site B). During the transitional
// phase, the auth layer reads from UserSiteGrant first, then falls
// back to User.allowedSites with an audit warning.
//
// `roleCode` now references the Role catalog (Phase 1).
// `validFrom`/`validUntil` support time-bound grants (e.g. temp coverage).
// `createdBy` tracks who issued the grant for audit.
//
// See: ITAM Shared Platform §4.4
// ============================================================
model UserSiteGrant {
  userId     String
  siteCode   String
  roleCode   String    @default("viewer")
  active     Boolean   @default(true)
  validFrom  DateTime?
  validUntil DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleCode], references: [code], onDelete: Restrict)

  @@id([userId, siteCode])
  @@index([siteCode, active])
  @@index([userId, active])
  @@index([roleCode, active])
}

// ============================================================
// 21) AuditLog — ประวัติการเปลี่ยนแปลง
// ============================================================
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  summary   String
  detail    String? // JSON string
  actor     String   @default("system")
  // NF-2 FIX: Canonical Site FK for audit entries.
  // Populated by logAudit() when the action is Site-scoped.
  // Null = global action (e.g., LOGIN, AUTH_FALLBACK) or legacy entry
  // that predates this field. Site-scoped queries filter on this column
  // instead of resolving entityId → entity → Site (eliminates N+1).
  siteCode  String?
  // P0-SCHEMA-FIXES: Enhanced attribution fields.
  // userId/ipAddress/userAgent capture who/where/from-what-device the
  // action was taken. Populated by audit-enhanced.ts wrapper (the B4
  // frozen audit.ts is unchanged — values are also stored in detail._meta
  // until audit.ts is refactored to populate these directly).
  userId    String?
  ipAddress String?
  userAgent String?
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([siteCode, createdAt])
  @@index([userId])
  @@index([isDemo])
}

// ============================================================
// 22) AppSetting — ตั้งค่าแอป
// ============================================================
model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  isDemo    Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@index([isDemo])
}

