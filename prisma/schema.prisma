// 0) Organization Profile — หัวใจความยืดหยุ่น (ข้อ 1, 2)
//    เก็บชื่อแอป, โลโก้, tagline, สีหลัก, ประเภทอุตสาหกรรม
//    เปลี่ยนได้ตลอด ไม่กระทบข้อมูล
// ============================================================
model OrganizationProfile {
  id            String   @id @default(cuid())
  // ── ข้อ 1: ชื่อไม่อ้างสาขาเฉพาะ ──
  appName       String   @default("ระบบจัดการสินทรัพย์") // ไม่อ้าง "โรงพยาบาล" หรือ "โรงงาน"
  appTagline    String   @default("Asset Management System")
  industryType  String   @default("general") // general | hospital | factory | office | school | government
  // ── ข้อ 2: โลโก้ + สี ──
  logoUrl       String?  // URL รูปภาพ หรือ emoji
  primaryColor  String   @default("#f97316") // สีหลัก (ส้ม default)
  accentColor   String   @default("#0d9488") // สีรอง (เขียว teal default)
  // ── ตั้งค่าระบบ ──
  language      String   @default("th") // th | en
  timezone      String   @default("Asia/Bangkok")
  currency      String   @default("THB")
  // ── ข้อ 3: สิทธิ์การ import ──
  allowExcelImport Boolean @default(true)
  // ── Audit ──
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================================
// 1) Asset Number Pattern — ข้อ 4: เลขทะเบียนกำหนดเองได้
//    รูปแบบ: {prefix}-{seq:5} หรือ {dept:4}-{type:3}-{seq:3}-{year:2}
//    ตัวอย่าง:
//      โรงงาน: "ASSET-{seq:5}" → ASSET-00001
//      โรงพยาบาล: "{dept:4}-{type:3}-{seq:3}-{year:2}" → ACC-PRT-001-26
// ============================================================
model AssetNumberPattern {
  id            String   @id @default(cuid())
  name          String   // เช่น "รูปแบบโรงงาน", "รูปแบบโรงพยาบาล"
  pattern       String   // {prefix}-{seq:5} หรือ {dept:4}-{type:3}-{seq:3}-{year:2}
  description   String?
  isActive      Boolean  @default(false) // ใช้ได้ทีละ 1 pattern
  // ── ค่า default สำหรับแต่ละ segment ──
  defaultPrefix String?  // ถ้า pattern มี {prefix}
  seqPadding    Int      @default(5) // จำนวนหลักของเลขลำดับ
  seqStart      Int      @default(1) // เลขเริ่มต้น
  // ── Audit ──
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================================
// 2) Device — อุปกรณ์ IT หลัก (ขยายจากเดิม)
// ============================================================
model Device {
  id              String   @id @default(cuid())
  assetCode       String   @unique // เลขทะเบียน (ตามรูปแบบ AssetNumberPattern) — maps from asset_no
  name            String   // ชื่ออุปกรณ์ (derived from brand+model for display)
  brand           String
  model           String
  type            String   // ประเภท: PRINTER | SCANNER | COMPUTER | NETWORK | OTHER — maps from device_type
  serialNumber    String?  // maps from serial
  status          String   @default("Active") // Active | In Repair | Retired | Spare | Inactive
  site            String   // สาขา/ที่ตั้ง
  department      String?
  departmentCode  String?  // maps from department_code
  parentRef       String?
  displayLabel    String?  // maps from asset_site_code
  location        String?
  building        String?
  floor           String?
  room            String?  // NEW (ไม่มีในเดิม)
  // ── การซื้อ ──
  purchaseDate    String?  // maps from install_date
  purchasePrice   Float?   // ราคาซื้อ (THB) — NEW
  salvageValue    Float?   @default(0) // มูลค่าซาก — NEW
  usefulLife      Int?     // อายุการใช้งาน (เดือน) — NEW
  warrantyMonths  Int      @default(12)
  warrantyEnd     String?  // ISO date — วันหมดประกัน
  vendor          String?  // ผู้ขาย
  contractNo      String?  // maps from contract_no — เพิ่มจากเดิม
  uninstallDate   String?  // maps from uninstall_date — เพิ่มจากเดิม
  // ── มิเตอร์ (สำหรับเครื่องพิมพ์) ──
  meterRequired   Boolean  @default(false) // maps from meter_required (TRUE/FALSE)
  meterMode       String?  // TOTAL | BW_COLOR — maps from meter_mode
  lastMeterBw     Int      @default(0)
  lastMeterColor  Int      @default(0)
  // ── เครือข่าย ──
  ip              String?
  mac             String?
  remoteId        String?  // maps from remote_id — TeamViewer/AnyDesk ID
  // ── มอบหมาย ──
  currentAssignee String?  // ผู้ใช้ปัจจุบัน (denormalized) — NEW
  // ── หมายเหตุ ──
  remark          String?
  costCenter      String?  // maps from cost_center
  deviceGroup     String?  // maps from device_group
  // ── Audit ──
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       String?  @default("System") // maps from updated_by

  // Relations
  meterReadings     MeterReading[]
  transfers         DeviceTransfer[]
  assignments       Assignment[]
  maintenanceLogs   MaintenanceLog[]
  workOrders        WorkOrder[]
  stockTransactions StockTransaction[]
}

// ============================================================
// 3) Meter Reading — การจดมิเตอร์
// ============================================================
model MeterReading {
  id                       String   @id @default(cuid())
  readingId                String?  @unique // maps from reading_id (MR-YYYYMMDDHHMMSS-NNNNN หรือ HIST-NN-YYYY-MM)
  deviceId                 String
  assetCode                String?  // maps from asset_no — เก็บไว้สำหรับ CSV import (lookup deviceId ภายหลัง)
  readingDate              String   // ISO date — maps from reading_date
  readingMonth             String?  // YYYY-MM — maps from reading_month
  meterBw                  Int      @default(0) // maps from meter_bw
  meterColor               Int      @default(0) // maps from meter_color
  pagesBw                  Int      @default(0) // delta BW — maps from pages_bw
  pagesColor               Int      @default(0) // delta Color — maps from pages_color
  prevMeterBw              Int      @default(0) // maps from prev_meter_bw
  prevMeterColor           Int      @default(0) // maps from prev_meter_color
  readingType              String?  // MONTHLY | INITIAL | FINAL | RESET | CHECKOUT | SEND_REPAIR | RETURN — maps from reading_type
  readBy                   String?  // maps from read_by
  remark                   String?  // maps from remark
  locationAtReading        String?  // maps from location_at_reading
  siteAtReading            String?  // maps from site_at_reading
  buildingAtReading        String?  // maps from building_at_reading
  floorAtReading           String?  // maps from floor_at_reading
  departmentAtReading      String?  // maps from department_at_reading
  departmentCodeAtReading  String?  // maps from department_code_at_reading
  eventType                String?  // maps from event_type
  eventId                  String?  // maps from event_id (FK → Location_History.Log_ID)
  createdAt                DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

// ============================================================
// 4) Cycle — รอบจดมิเตอร์
// ============================================================
model Cycle {
  id          String   @id @default(cuid())
  name        String
  startDate   String   // ISO date
  endDate     String   // ISO date
  status      String   @default("active") // active | ended | cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// 5) Device Transfer — ประวัติการย้าย
// ============================================================
model DeviceTransfer {
  id                 String   @id @default(cuid())
  logId              String?  @unique // maps from Log_ID (MV-YYYYMMDDHHMMSS-NNNNN)
  deviceId           String
  assetCode          String?  // maps from Asset_No — เก็บไว้สำหรับ CSV import
  moveDate           String?  // maps from Move_Date — ISO datetime
  action             String?  // maps from Action — TRANSFER | TRANSFER_SITE | STATUS_CHANGE | STATUS_AND_TRANSFER | TRANSFER_BY_LIFECYCLE
  fromStatus         String?  // maps from From_Status
  toStatus           String?  // maps from To_Status
  fromSite           String?  // maps from From_Site
  fromAssetSiteCode  String?  // maps from From_AssetSiteCode
  fromBuilding       String?  // maps from From_Building
  fromFloor          String?  // maps from From_Floor
  fromDepartment     String?  // maps from From_Department
  fromLocation       String?  // maps from From_Location
  toSite             String   // maps from To_Site
  toAssetSiteCode    String?  // maps from To_AssetSiteCode
  toBuilding         String?  // maps from To_Building
  toFloor            String?  // maps from To_Floor
  toDepartment       String?  // maps from To_Department
  toLocation         String?  // maps from To_Location
  meterReadingId     String?  // maps from Meter_Reading_ID (FK → Meter_Readings.reading_id)
  movedBy            String?  // maps from Moved_By
  remark             String?  // maps from Remark
  transferDate       String   // ISO date (computed from moveDate for backward compat)
  reason             String?  // alias for remark (backward compat)
  createdAt          DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

// ============================================================
// 6) Assignment — การมอบหมายอุปกรณ์
// ============================================================
model Assignment {
  id                 String   @id @default(cuid())
  assignmentId       String?  @unique // maps from Assignment_ID
  deviceId           String
  assignee           String   // maps from Assignee — ชื่อหรือ email
  assigneeRole       String?  // maps from Assignee_Role
  department         String?  // maps from Department
  checkoutDate       String   // maps from Checkout_Date — ISO date
  expectedReturnDate String?  // maps from Expected_Return_Date
  actualReturnDate   String?  // maps from Actual_Return_Date
  status             String   @default("active") // maps from Status — active | returned
  notes              String?  // maps from Notes
  createdAt          DateTime @default(now()) // maps from Created_At
  updatedAt          DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

// ============================================================
// 7) Maintenance Log — ประวัติซ่อมบำรุง (legacy, ใช้คู่กับ WorkOrder)
// ============================================================
model MaintenanceLog {
  id           String   @id @default(cuid())
  logId        String?  @unique // maps from Log_ID (MNT-xxxxxxxx)
  deviceId     String
  type         String   // maps from Type — repair | maintenance | inspection | upgrade
  status       String   @default("open") // maps from Status — open | in_progress | completed | cancelled
  startDate    String   // maps from Start_Date — ISO date
  endDate      String?  // maps from End_Date
  cost         Float?   // maps from Cost
  vendor       String?  // maps from Vendor
  description  String   // maps from Description
  resolvedNote String?  // maps from Resolved_Note
  createdAt    DateTime @default(now()) // maps from Created_At
  updatedAt    DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

// ============================================================
// 8) Work Order — ใบงานแจ้งซ่อม (aligned with Services App)
//    ระบบแจ้งซ่อมครบวงจร: ผู้ใช้แจ้ง → ช่างรับงาน → ซ่อม → ปิดงาน
// ============================================================
model WorkOrder {
  id               String   @id @default(cuid())
  woNumber         String?  @unique // WO-YYYYMMDD-NNN
  requestId        String?  // dedup ID

  // ── ข้อมูลการแจ้ง ──
  subject          String   // ประเภทปัญหา
  building         String?
  location         String?
  details          String?
  priority         String   @default("ปกติ") // ปกติ | ปานกลาง | สูง | ด่วน

  // ── ผู้แจ้ง ──
  reporterName     String?
  reporterEmail    String?
  tel              String?
  employeeCode     String?
  submissionSource String   @default("guest") // session | guest | line
  trackable        Boolean  @default(false)

  // ── LINE OA integration (Task ID: NOTIFY-LINE) ──
  // lineUserId  — LINE user ID (ถ้าใบงานนี้แจ้งผ่าน LINE)
  // lineMessageId — message ID ของข้อความแจ้งซ่อมต้นทาง (สำหรับ reply)
  lineUserId       String?
  lineMessageId    String?

  // ── เทมเพลตสำหรับพิมพ์ (VISUAL-TEMPLATE-EDITOR) ──
  // ID ของ DocumentTemplate ที่ Fix ไว้ — พิมพ์ครั้งถัดไปใช้เทมเพลตเดิมอัตโนมัติ
  printTemplateId  String?

  // ── ลูกค้าภายนอก ──
  externalMeta     String?  // JSON

  // ── รูปภาพ 3 ช่วง ──
  picBefore        String?  // base64 หรือ URL
  picOnsite        String?
  picAfter         String?

  // ── สถานะ ──
  status           String   @default("PENDING") // PENDING | IN_PROGRESS | WAITING_PARTS | COMPLETED | CANCELLED
  acceptStatus     String?

  // ── มอบหมาย ──
  assignedTo       String?  // username ช่าง
  assignedBy       String?
  assignedAt       DateTime?
  assignmentNote   String?

  // ── หมายเหตุ ──
  detailsAdmin     String?
  dateAdmin        String?

  // ── ผลการแก้ไข ──
  resolution       String?  // ผลการแก้ไข (option label)
  resolutionGroup  String?  // group label ของผลการแก้ไข

  // ── ปลดล็อกแก้ไข ──
  editUnlockActive Boolean  @default(false)
  editUnlockBy     String?
  editUnlockAt     DateTime?
  editUnlockNote   String?

  // ── วันที่สำคัญ ──
  workCompletedAt  DateTime?
  closedAt         DateTime?
  canceledAt       DateTime?
  cancelReason     String?

  // ── เชื่อม Device ──
  deviceId         String?  // optional FK

  // ── Audit ──
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  device           Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  messages         WorkOrderMessage[]
  images           WorkOrderImage[]
  review           WorkOrderReview?
}

// ============================================================
// 18b) Work Order Images — รองรับหลายรูปต่อขั้นตอน (ก่อน/หน้างาน/หลัง)
//      แทน picBefore/picOnsite/picAfter แบบ 1 รูป เดิม
// ============================================================
model WorkOrderImage {
  id          String   @id @default(cuid())
  workOrderId String
  stage       String   // before | onsite | after
  image_data  String   // base64 data URL หรือ URL
  fileName    String?
  uploadedBy  String?
  createdAt   DateTime @default(now())

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([stage])
  @@map("work_order_images")
}

model WorkOrderMessage {
  id          String   @id @default(cuid())
  workOrderId String
  message     String
  author      String?
  authorRole  String?  // admin | staff | reporter | system
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

model WorkOrderReview {
  id          String   @id @default(cuid())
  workOrderId String   @unique
  rating      Int      // 1-5
  comment     String?
  reviewedBy  String?
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

// ============================================================
// 9) Stock Item — สินค้าคงคลัง (ข้อ 3: import จาก Excel)
// ============================================================
model StockItem {
  id                String   @id @default(cuid())
  productCode       String   @unique // maps from ProductCode
  productName       String   // maps from ProductName
  category          String?
  brand             String?
  model             String?
  unit              String   @default("ชิ้น") // maps from Unit
  quantity          Int      @default(0) // maps from CurrentStock
  minQuantity       Int      @default(0) // maps from ReorderPoint
  maxQuantity       Int      @default(0)
  unitCost          Float?   // maps from UnitPrice
  totalValue        Float?   // maps from TotalValue — COMPUTED (quantity × unitCost)
  location          String?
  site              String?
  compatibleDevices String?
  remark            String?
  active            Boolean  @default(true) // maps from Status
  lastUpdated       String?  // maps from LastUpdated
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transactions      StockTransaction[]
  purchaseOrderItems PurchaseOrderItem[]
}

// ============================================================
// 10) Stock Transaction — รายการรับเข้า/เบิกออก
// ============================================================
model StockTransaction {
  id              String   @id @default(cuid())
  txnNumber       String?  // STX-YYYYMMDD-NNN — maps from ReceiptNo (IN) or IssueNo (OUT)
  stockItemId     String
  productCode     String?  // maps from ProductCode — denormalized for CSV import
  productName     String?  // maps from ProductName — denormalized
  type            String   // IN | OUT | ADJUST
  quantity        Int      // maps from Quantity
  unit            String?  // maps from Unit
  balanceAfter    Int      @default(0)
  reason          String?
  requester       String?  // maps from Requester (StockOut)
  department      String?  // maps from Department (StockOut)
  purpose         String?  // maps from Purpose (StockOut)
  approver        String?  // maps from Approver (StockOut)
  approvedAt      String?  // maps from ApprovedAt (StockOut)
  workOrderId     String?
  workOrderNo     String?  // maps from WorkOrderNo — for CSV import
  deviceId        String?
  cost            Float?   // maps from TotalValue
  unitCost        Float?   // maps from UnitPrice
  vendor          String?  // maps from Supplier
  receiver        String?  // maps from Receiver (StockIn)
  purchaseOrderNo String?  // maps from PurchaseOrderNo (StockIn)
  txnDate         String   // maps from Date
  performedBy     String?  // maps from PerformedBy
  remark          String?  // maps from Remark
  sourceKey       String?  // maps from source_key
  processedFlag   String?  // maps from processed_flag
  // ── Approval workflow (PART 1: Stock Pending Approval System) ──
  // null = immediate (legacy/IN-OUT-ADJUST processed at once)
  // PENDING = waiting for approval (stock NOT yet reduced)
  // APPROVED = approved (stock reduced on approval)
  // REJECTED = rejected (no stock change)
  approvalStatus  String?  // null (immediate) | PENDING | APPROVED | REJECTED
  approvalMode    String?  // manual | auto
  autoApproveAt   String?  // ISO datetime for auto-approval
  rejectReason    String?  // reason when rejected
  createdAt       DateTime @default(now())

  stockItem       StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  device          Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
}

// ============================================================
// 11) Purchase Order — ใบสั่งซื้อ
// ============================================================
model PurchaseOrder {
  id              String   @id @default(cuid())
  poNumber        String?  @unique // PO-YYYYMMDD-NNN
  orderDate       String   // ISO date
  supplier        String?
  status          String   @default("open") // open | partial | received | cancelled
  totalValue      Float?   // มูลค่ารวม
  createdBy       String?
  remark          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  stockItemId     String
  quantityOrdered Int
  quantityReceived Int     @default(0)
  unitPrice       Float?
  totalValue      Float?

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  stockItem       StockItem     @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
}

// ============================================================
// 12) Document Template — ข้อ 5: เทมเพลตแยกประเภท
//     sticker | pdf | work-order | stock-out | stock-in | purchase-order
// ============================================================
model DocumentTemplate {
  id          String   @id @default(cuid())
  name        String
  type        String   // sticker | pdf | work-order | stock-out | stock-in | purchase-order
  category    String?  // หมวดหมู่ย่อย (เช่น sticker: asset | meter | location)
  content     String   // JSON: { canvas, elements, table, footer, etc. }
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  // ── VISUAL-TEMPLATE-EDITOR: ติ๊กว่า Fix กับเทมเพลตนี้ (จำสำหรับใบงานทั้งหมด) ──
  isFixed     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// 13) Import Job — ข้อ 3: Excel import แยกฟังก์ชัน
// ============================================================
model ImportJob {
  id          String   @id @default(cuid())
  jobType     String   // device | work-order | stock | meter-reading | master-data
  fileName    String
  fileType    String   @default("excel") // excel | csv
  status      String   @default("pending") // pending | processing | completed | failed
  totalRows   Int      @default(0)
  processedRows Int    @default(0)
  errorRows   Int      @default(0)
  errors      String?  // JSON: [{ row, error }]
  uploadedBy  String?
  createdAt   DateTime @default(now())
  completedAt DateTime?
}

// ============================================================
// 14) Master Item — ข้อมูลมาตรฐาน (Brand, Type, Model, Department, etc.)
// ============================================================
model MasterItem {
  id           String   @id @default(cuid())
  category     String   // Brand | Type | Model | Department | Status | DeviceGroup
  code         String
  label        String
  parentRef    String?
  displayLabel String?
  siteCode     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================
// 15) Site — สาขา/ที่ตั้ง
// ============================================================
model Site {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
}

model SiteRate {
  id        String   @id @default(cuid())
  siteCode  String
  bwRate    Float    @default(0.5)
