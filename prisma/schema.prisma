// ============================================================
// ITAM Database Schema — ตรงกับ Google Sheets จริง
// ทยอยสร้างทีละ model เมื่อได้ headers ของแต่ละ sheet
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1) Devices — อุปกรณ์ IT หลัก
//    Source: sheet "Devices" (28 columns)
// ============================================================
model Device {
  id              String   @id @default(cuid())
  assetNo         String   @unique @map("asset_no")
  deviceType      String?  @map("device_type")
  brand           String?
  model           String?
  serial          String?
  building        String?
  floor           String?
  department      String?
  location        String?
  departmentCode  String?  @map("department_code")
  status          String   @default("Active")
  site            String?
  contractNo      String?  @map("contract_no")
  ip              String?
  mac             String?
  remoteId        String?  @map("remote_id")
  remark          String?
  vendor          String?
  installDate     String?  @map("install_date") // ISO date string
  uninstallDate   String?  @map("uninstall_date")
  warrantyEnd     String?  @map("warranty_end")
  deviceGroup     String?  @map("device_group")
  costCenter      String?  @map("cost_center")
  meterRequired   Boolean  @default(false) @map("meter_required")
  meterMode       String?  @map("meter_mode") // TOTAL | BW_COLOR
  assetSiteCode   String?  @map("asset_site_code")
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedBy       String?  @default("System") @map("updated_by")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  meterReadings     MeterReading[]
  locationHistories LocationHistory[]
  assignments       Assignment[]
  maintenanceLogs   MaintenanceLog[]

  // Performance indexes — critical for dashboard queries on 2,378+ devices
  @@index([status])
  @@index([deviceType])
  @@index([site])
  @@index([status, site])
  @@index([meterRequired])
  @@index([createdAt])
  @@map("devices")
}

// ============================================================
// 2) Meter_Readings — การจดมิเตอร์รายเดือน
//    Source: sheet "Meter_Readings" (20 columns)
// ============================================================
model MeterReading {
  id                        String   @id @default(cuid())
  readingId                 String?  @map("reading_id") // เช่น HIST-11-2025-01
  assetNo                   String   @map("asset_no")
  readingDate               String?  @map("reading_date") // ISO datetime string
  readingMonth              String?  @map("reading_month") // เช่น 2025-01
  meterBw                   Int      @default(0) @map("meter_bw")
  meterColor                Int      @default(0) @map("meter_color")
  pagesBw                   Int      @default(0) @map("pages_bw") // แผ่นที่ใช้ (delta BW)
  pagesColor                Int      @default(0) @map("pages_color") // แผ่นที่ใช้ (delta Color)
  locationAtReading         String?  @map("location_at_reading")
  readBy                    String?  @map("read_by")
  remark                    String?
  prevMeterBw               Int      @default(0) @map("prev_meter_bw")
  prevMeterColor            Int      @default(0) @map("prev_meter_color")
  readingType               String?  @map("reading_type") // MONTHLY | INITIAL | FINAL | RESET | CHECKOUT | SEND_REPAIR | RETURN
  eventType                 String?  @map("event_type") // เชื่อมกับ Location_History (ถ้ามี)
  eventId                   String?  @map("event_id")
  siteAtReading             String?  @map("site_at_reading")
  buildingAtReading         String?  @map("building_at_reading")
  floorAtReading            String?  @map("floor_at_reading")
  departmentAtReading       String?  @map("department_at_reading")
  departmentCodeAtReading   String?  @map("department_code_at_reading")
  createdAt                 DateTime @default(now()) @map("created_at")

  // Relation
  device                    Device   @relation(fields: [assetNo], references: [assetNo], onDelete: Cascade)

  // Performance indexes — critical for dashboard paper-usage queries on 14k+ readings
  @@index([assetNo])
  @@index([readingMonth])
  @@index([readingDate])
  @@index([readingMonth, assetNo])
  @@index([readingType])
  @@index([createdAt])
  @@map("meter_readings")
}

// ============================================================
// 6) Cycles — รอบจดมิเตอร์รายเดือน
//    Aligned with Apps Script CycleService.gs (15 columns)
//    Statuses: NONE → QUEUED → OPEN → CLOSED (legacy: active|ended|draft)
// ============================================================
model Cycle {
  id              String   @id @default(cuid())
  name            String   @map("Name")
  cycleMonth      String?  @map("Cycle_Month") // e.g. 2025-01
  startDate       String   @map("Start_Date")
  endDate         String   @map("End_Date")
  deadlineDate    String?  @map("Deadline_Date") // soft deadline for meter entry
  status          String   @default("OPEN") @map("Status") // NONE | QUEUED | OPEN | CLOSED | active | ended | draft
  totalDevices    Int      @default(0) @map("Total_Devices")
  completedCount  Int      @default(0) @map("Completed_Count")
  missingCount    Int      @default(0) @map("Missing_Count")
  bypassReason    String?  @map("Bypass_Reason")
  bypassAckBy     String?  @map("Bypass_Ack_By")
  unlockAt        DateTime? @map("Unlock_At")
  unlockBy        String?  @map("Unlock_By")
  startedAt       DateTime? @map("Started_At")
  closedAt        DateTime? @map("Closed_At")
  remarks         String?  @map("Remarks")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([cycleMonth])
  @@index([startDate])
  @@map("cycles")
}

// ============================================================
// 13) License_Records — ลิขสิทธิ์ซอฟต์แวร์
//    Source: sheet "License_Records" (9 columns)
// ============================================================
model LicenseRecord {
  id          String   @id @default(cuid())
  licenseId   String?  @map("License_ID")
  assetNo     String?  @map("Asset_No") // เชื่อมกับ Device (nullable เพราะบาง license ไม่ได้ผูกเครื่อง)
  software    String   @map("Software")
  licenseType String?  @map("LicenseType") // OEM | Volume | Retail | Subscription | Open License
  licenseKey  String?  @map("License_Key") // product key
  quantity    Int      @default(1) @map("Quantity")
  expiryDate  String?  @map("Expiry_Date") // ISO date
  remark      String?  @map("Remark")
  updatedAt   DateTime @updatedAt @map("UpdatedAt")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([assetNo])
  @@index([software])
  @@index([expiryDate])
  @@map("license_records")
}

// ============================================================
// 11) Assignments — การมอบหมายอุปกรณ์ (เพิ่มจาก Next.js)
//    ไม่มีใน Google Sheets เดิม — สร้างใหม่
// ============================================================
model Assignment {
  id                String   @id @default(cuid())
  assignmentId      String?  @unique @map("Assignment_ID") // เช่น ASG-XXXXX
  assetNo           String   @map("Asset_No")
  assignee          String   @map("Assignee") // ชื่อ-นามสกุล หรือ อีเมล
  assigneeRole      String?  @map("Assignee_Role") // ตำแหน่ง
  department        String?  @map("Department")
  checkoutDate      String?  @map("Checkout_Date") // ISO date
  expectedReturnDate String? @map("Expected_Return_Date")
  actualReturnDate  String?  @map("Actual_Return_Date")
  status            String   @default("active") @map("Status") // active | returned
  notes             String?  @map("Notes")
  createdAt         DateTime @default(now()) @map("Created_At")

  // Relation
  device            Device   @relation(fields: [assetNo], references: [assetNo], onDelete: Cascade)

  @@index([assetNo])
  @@index([status])
  @@map("assignments")
}

// ============================================================
// 12) MaintenanceLog — ประวัติการซ่อมบำรุง (เพิ่มจาก Next.js)
//    ไม่มีใน Google Sheets เดิม — สร้างใหม่
// ============================================================
model MaintenanceLog {
  id            String   @id @default(cuid())
  logId         String?  @unique @map("Log_ID") // เช่น MNT-XXXXX
  assetNo       String   @map("Asset_No")
  type          String   @map("Type") // repair | maintenance | inspection | upgrade
  status        String   @default("open") @map("Status") // open | in_progress | completed | cancelled
  startDate     String?  @map("Start_Date") // ISO date
  endDate       String?  @map("End_Date")
  cost          Float?   @map("Cost") // ค่าใช้จ่าย (฿)
  vendor        String?  @map("Vendor") // ร้านซ่อม/ผู้ให้บริการ
  description   String?  @map("Description") // อาการ/งานที่ทำ
  resolvedNote  String?  @map("Resolved_Note") // ผลการซ่อม
  createdAt     DateTime @default(now()) @map("Created_At")

  // Relation
  device        Device   @relation(fields: [assetNo], references: [assetNo], onDelete: Cascade)

  @@index([assetNo])
  @@index([status])
  @@index([type])
  @@map("maintenance_logs")
}

// ============================================================
// 10) App_Settings — ตั้งค่าแอป (key-value)
//    Source: sheet "App_Settings" (4 columns)
// ============================================================
model AppSetting {
  id          String   @id @default(cuid())
  key         String   @unique @map("Key") // เช่น appName, notifyEmails, telegramToken
  value       String?  @map("Value") // ค่า (เก็บเป็น string ทั้งหมด แม้ boolean/number)
  description String?  @map("Description") // คำอธิบาย
  updatedAt   DateTime @updatedAt @map("UpdatedAt")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("app_settings")
}

// ============================================================
// 9) Site_Attributes — ข้อมูลสาขา + อัตราค่ากระดาษ
//    Source: sheet "Site_Attributes" (6 columns)
// ============================================================
model SiteAttribute {
  id            String   @id @default(cuid())
  siteCode      String   @unique @map("SiteCode") // เช่น MECUD
  siteName      String?  @map("SiteName") // เช่น ศูนย์แพทย์โรงพยาบาลศูนย์อุดรธานี
  lineOa        String?  @map("LineOA") // LINE OA ID/Token
  hotline       String?  @map("Hotline") // เบอร์ติดต่อ
  paperRateBw   Float?   @default(0.5) @map("PaperRateBW") // ฿/แผ่น ขาวดำ
  paperRateColor Float?  @default(2.0) @map("PaperRateColor") // ฿/แผ่น สี
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("site_attributes")
}

// ============================================================
// 8) User_Permissions — สิทธิ์ผู้ใช้
//    Source: sheet "User_Permissions" (10 columns)
// ============================================================
model UserPermission {
  id            String   @id @default(cuid())
  email         String   @unique @map("Email")
  role          String   @map("Role") // Super Admin | Admin | Editor | Viewer
  active        Boolean  @default(true) @map("Active")
  name          String?  @map("Name")
  username      String?  @map("Username")
  passwordHash  String?  @map("PasswordHash")
  passwordSalt  String?  @map("PasswordSalt")
  remark        String?  @map("Remark")
  updatedAt     DateTime @updatedAt @map("UpdatedAt")
  lastLoginAt   String?  @map("LastLoginAt") // ISO datetime string
  allowedSites  String?  @map("Allowed_Sites") // ALL หรือ comma-separated
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([role])
  @@index([active])
  @@map("user_permissions")
}

// ============================================================
// 7) Audit_Log — ประวัติการใช้งานระบบ
//    Source: sheet "Audit_Log" (4 columns)
// ============================================================
model AuditLog {
  id         String   @id @default(cuid())
  timestamp  String?  @map("Timestamp") // ISO datetime string
  action     String   @map("Action") // UPDATE_DEVICE | CREATE | DELETE | ASSIGN | RETURN | MAINTENANCE | SYNC | etc.
  user       String?  @map("User") // อีเมลผู้ทำรายการ
  details    String?  @map("Details") // JSON string ของรายละเอียด
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([action])
  @@index([user])
  @@index([timestamp])
  @@map("audit_logs")
}

// ============================================================
// 5) Location_History — ประวัติการย้ายตำแหน่ง/เปลี่ยนสถานะ
//    Source: sheet "Location_History" (20 columns)
// ============================================================
model LocationHistory {
  id                  String   @id @default(cuid())
  logId               String?  @map("Log_ID") // เช่น MV-20260518114325-01325
  assetNo             String   @map("Asset_No")
  moveDate            String?  @map("Move_Date") // ISO datetime string
  action              String?  @map("Action") // TRANSFER | TRANSFER_SITE | STATUS_CHANGE | STATUS_AND_TRANSFER | TRANSFER_BY_LIFECYCLE
  fromStatus          String?  @map("From_Status")
  toStatus            String?  @map("To_Status")
  fromSite            String?  @map("From_Site")
  fromAssetSiteCode   String?  @map("From_AssetSiteCode")
  fromBuilding        String?  @map("From_Building")
  fromFloor           String?  @map("From_Floor")
  fromDepartment      String?  @map("From_Department")
  fromLocation        String?  @map("From_Location")
  toSite              String?  @map("To_Site")
  toAssetSiteCode     String?  @map("To_AssetSiteCode")
  toBuilding          String?  @map("To_Building")
  toFloor             String?  @map("To_Floor")
  toDepartment        String?  @map("To_Department")
  toLocation          String?  @map("To_Location")
  meterReadingId      String?  @map("Meter_Reading_ID") // เชื่อมกับ MeterReading (ถ้าจดมิเตอร์พร้อมย้าย)
  movedBy             String?  @map("Moved_By") // อีเมลผู้ทำรายการ
  remark              String?  @map("Remark")
  // Transfer acknowledge flow (Apps Script commit 6e57904):
  //   When a device is transferred WITHOUT a meter reading, the user must
  //   acknowledge that "มิเตอร์นับต่อเนื่อง" (meter continues) by checking a
  //   checkbox. This replaces the old free-text skipMeterReason.
  meterSkipAcknowledged Boolean? @default(false) @map("Meter_Skip_Acknowledged")
  meterSkipReason     String?  @map("Meter_Skip_Reason") // optional note (was the old field)
  readingType         String?  @map("Reading_Type") // MONTHLY | INITIAL | FINAL | RESET | CHECKOUT | SEND_REPAIR | RETURN (lifecycle-derived)
  createdAt           DateTime @default(now()) @map("created_at")

  // Relation
  device              Device   @relation(fields: [assetNo], references: [assetNo], onDelete: Cascade)

  @@index([assetNo])
  @@index([moveDate])
  @@index([action])
  @@map("location_history")
}

// ============================================================
// 6b) Meter_Report_Snapshots — Immutable billing snapshots
//     Aligned with Apps Script MeterSnapshotService.gs (commit 67f8e54)
//     Created automatically when a cycle is CLOSED. Contains frozen copies
//     of all meter readings for that cycle month, with SHA-256 hash for
//     tamper detection. Prevents retroactive edits from changing historical bills.
// ============================================================
model MeterReportSnapshot {
  id              String   @id @default(cuid())
  snapshotId      String   @unique @map("Snapshot_ID") // e.g. MRS-202608-R1-20260812150000
  cycleMonth      String   @map("Cycle_Month") // e.g. 2026-08
  revision        Int      @default(1) @map("Revision") // increments on amendments
  status          String   @default("ACTIVE") @map("Status") // ACTIVE | SUPERSEDED
  ruleVersion     String?  @map("Rule_Version") // calc logic version, e.g. "v2-initial-baseline"
  rowCount        Int      @default(0) @map("Row_Count")
  totalPagesBw    Int      @default(0) @map("Total_Pages_BW")
  totalPagesColor Int      @default(0) @map("Total_Pages_Color")
  totalCost       Float    @default(0) @map("Total_Cost")
  contentHash     String   @map("Content_Hash") // SHA-256 hex (64 chars)
  createdBy       String?  @map("Created_By") // user email
  createdAt       DateTime @default(now()) @map("created_at")

  // Relation — one snapshot has many frozen rows
  rows            MeterReportSnapshotRow[]
  amendments      MeterReportAmendment[]

  @@index([cycleMonth])
  @@index([status])
  @@index([cycleMonth, revision])
  @@map("meter_report_snapshots")
}

// ============================================================
// 6c) Meter_Report_Snapshot_Rows — Frozen reading data (27 cols)
//     A copy of MeterReading + Device fields + rates, taken at snapshot time.
//     Append-only: never updated after creation.
// ============================================================
model MeterReportSnapshotRow {
  id              String   @id @default(cuid())
  snapshotId      String   @map("Snapshot_ID") // FK to MeterReportSnapshot.snapshotId
  assetNo         String   @map("Asset_No")
  readingDate     String?  @map("Reading_Date")
  readingMonth    String?  @map("Reading_Month")
  meterBw         Int      @default(0) @map("Meter_BW")
  meterColor      Int      @default(0) @map("Meter_Color")
  pagesBw         Int      @default(0) @map("Pages_BW")
  pagesColor      Int      @default(0) @map("Pages_Color")
  prevMeterBw     Int      @default(0) @map("Prev_Meter_BW")
  prevMeterColor  Int      @default(0) @map("Prev_Meter_Color")
  readingType     String?  @map("Reading_Type")
  brand           String?  @map("Brand")
  model           String?  @map("Model")
  siteAtReading   String?  @map("Site_At_Reading")
  buildingAtReading String? @map("Building_At_Reading")
  floorAtReading  String?  @map("Floor_At_Reading")
  departmentAtReading String? @map("Department_At_Reading")
  rateBw          Float    @default(0.5) @map("Rate_BW")
  rateColor       Float    @default(2.0) @map("Rate_Color")
  costBw          Float    @default(0) @map("Cost_BW")
  costColor       Float    @default(0) @map("Cost_Color")
  readBy          String?  @map("Read_By")
  remark          String?  @map("Remark")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relation
  snapshot        MeterReportSnapshot @relation(fields: [snapshotId], references: [snapshotId], onDelete: Cascade)

  @@index([snapshotId])
  @@index([assetNo])
  @@map("meter_report_snapshot_rows")
}

// ============================================================
// 6d) Meter_Report_Amendments — Audit trail for snapshot corrections
//     When a CLOSED cycle's data needs correction, an amendment is created
//     (never overwrites the original snapshot). Records who/when/why.
// ============================================================
model MeterReportAmendment {
  id              String   @id @default(cuid())
  amendmentId     String   @unique @map("Amendment_ID") // e.g. MRA-202608-20260812150000
  cycleMonth      String   @map("Cycle_Month")
  reason          String   @map("Reason")
  createdBy       String?  @map("Created_By")
  createdAt       DateTime @default(now()) @map("created_at")
  // Link to the new snapshot revision created by this amendment
  newSnapshotId   String?  @map("New_Snapshot_ID")

  // Relation
  snapshot        MeterReportSnapshot? @relation(fields: [newSnapshotId], references: [snapshotId], onDelete: SetNull)

  @@index([cycleMonth])
  @@map("meter_report_amendments")
}

// ============================================================
// 14) Stock_Items — คลังสต๊อกอุปกรณ์สิ้นเปลือง/อะไหล่
//     เช่น หมึกพิมพ์, กระดาษ, อะไหล่, สายไฟ, ฯลฯ
//     แยกจาก Device (ที่เป็นครุภัณฑ์ถาวร) — Stock = สิ้นเปลือง
// ============================================================
model StockItem {
  id            String   @id @default(cuid())
  itemId        String?  @map("Item_ID") // เช่น STK-0001
  name          String   @map("Name") // เช่น "หมึกพิมพ์ EPSON T544"
  category      String?  @map("Category") // เช่น หมึกพิมพ์, กระดาษ, อะไหล่, อุปกรณ์สำนักงาน
  brand         String?  @map("Brand")
  model         String?  @map("Model") // รุ่น/ขนาด
  unit          String   @default("ชิ้น") @map("Unit") // ชิ้น, กล่อง, แพ็ค, ม้วน
  quantity      Int      @default(0) @map("Quantity") // จำนวนคงเหลือ
  minQuantity   Int      @default(0) @map("Min_Quantity") // จุดสั่งซื้อ (เตือนเมื่อต่ำกว่า)
  maxQuantity   Int      @default(0) @map("Max_Quantity") // สต็อกสูงสุด
  unitCost      Float?   @map("Unit_Cost") // ราคาต่อหน่วย (฿)
  location      String?  @map("Location") // ตำแหน่งเก็บ (ตู้/ชั้น/ห้อง)
  site          String?  @map("Site") // สาขาที่เก็บ (null = กลาง)
  compatibleDevices String? @map("Compatible_Devices") // เช่น "EPSON L5290, L3210" (comma-separated)
  remark        String?  @map("Remark")
  active        Boolean  @default(true) @map("Active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  transactions  StockTransaction[]

  @@index([category])
  @@index([site])
  @@index([name])
  @@index([active])
  @@map("stock_items")
}

// ============================================================
// 15) Stock_Transactions — รายการเข้า/ออกสต็อก
//     type: IN (รับเข้า) | OUT (เบิกออก) | ADJUST (ปรับปรุง)
// ============================================================
model StockTransaction {
  id            String   @id @default(cuid())
  txnId         String?  @map("Txn_ID") // เช่น STX-0001
  stockItemId   String   @map("Stock_Item_ID")
  type          String   @map("Type") // IN | OUT | ADJUST
  quantity      Int      @map("Quantity") // จำนวน (IN=+, OUT=-, ADJUST=±)
  balanceAfter  Int      @default(0) @map("Balance_After") // คงเหลือหลังรายการ
  reason        String?  @map("Reason") // เหตุผล: ซื้อ, เบิกใช้, ย้าย, เสีย, ตรวจนับ
  relatedAssetNo String? @map("Related_Asset_No") // เชื่อมกับ Device (ถ้าเบิกไปใช้กับอุปกรณ์)
  cost          Float?   @map("Cost") // มูลค่ารวม (สำหรับ IN)
  vendor        String?  @map("Vendor") // ซื้อจาก
  txnDate       String   @map("Txn_Date") // ISO date
  performedBy   String?  @map("Performed_By") // อีเมลผู้ทำรายการ
  remark        String?  @map("Remark")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relation
  stockItem     StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([stockItemId])
  @@index([type])
  @@index([txnDate])
  @@index([relatedAssetNo])
  @@map("stock_transactions")
}

// ============================================================
// 16) Reports — รายงานที่บันทึกไว้ (snapshot ของ dashboard/cycle/audit/utilization)
//     สร้างโดยใช้ buildReport() ใน /api/reports/route.ts
// ============================================================
model Report {
  id          String   @id @default(cuid())
  type        String   @map("Type") // dashboard_summary | cycle | audit | utilization
  title       String   @map("Title")
  rangeKey    String   @map("Range_Key") // month | 30d | quarter | all
  filters     String?  @map("Filters") // JSON string
  data        String   @map("Data") // JSON string (the report payload)
  format      String   @default("json") @map("Format")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([type])
  @@index([createdAt])
  @@map("reports")
}

// ============================================================
// 4) Master_Category — หมวดหมู่ของ Master Items
//    Source: sheet "Master_Category" (4 columns)
// ============================================================
model MasterCategory {
  id           String   @id @default(cuid())
  categoryKey  String   @unique @map("CategoryKey") // DeviceType | Brand | Model | Department | Status | DeviceGroup
  displayName  String?  @map("DisplayName") // เช่น "ประเภทอุปกรณ์"
  sortOrder    Int      @default(0) @map("SortOrder") // ลำดับการแสดง
  active       Boolean  @default(true) @map("Active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("master_categories")
}

// ============================================================
// 3) Master_Items — ข้อมูลมาตรฐาน (Brand/Type/Model/Department/Status/DeviceGroup)
//    Source: sheet "Master_Items" (10 columns)
// ============================================================
model MasterItem {
  id              String   @id @default(cuid())
  itemId          String?  @map("ItemID") // เช่น MD-0164
  categoryKey     String   @map("CategoryKey") // Brand | Type | Model | Department | Status | DeviceGroup
  value           String   @map("Value") // ค่าจริง เช่น "ศูนย์บริการข้าราชการ..."
  groupName       String?  @map("GroupName") // ศูนย์สิทธิ์เบิกได้
  parentRef       String?  @map("ParentRef") // เช่น Brand|Type สำหรับ Model
  displayLabel    String?  @map("DisplayLabel")
  siteCode        String?  @map("SiteCode")
  allowedSites    String?  @map("AllowedSites") // ALL หรือ comma-separated
  active          Boolean  @default(true) @map("Active")
  departmentCode  String?  @map("DepartmentCode") // เช่น ACC-001
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([categoryKey])
  @@index([value])
  @@map("master_items")
}
