// ============================================================
// 29) PasswordResetToken — token สำหรับ register / reset / invite
//     type: 'register' (Method 2 invite) | 'reset' (forgot password) | 'invite'
//     data: JSON string with { name, phone, department, roleRequest } (for register)
// ============================================================
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String // user email
  token     String   @unique // random UUID
  type      String // 'register' | 'reset' | 'invite'
  data      String? // JSON: { name, phone, department, roleRequest } for registration
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

// ============================================================
// 30) SyncRun — ประวัติการ sync จาก Legacy Apps Script
//     mode: 'preview' (read-only diff) | 'apply' (write)
//     status: 'pending' | 'running' | 'completed' | 'failed' | 'cancelled'
// ============================================================
model SyncRun {
  id           String        @id @default(cuid())
  source       String // 'services' | 'itam' | 'stock'
  target       String // 'work-order' | 'device' | 'meter' | 'stock-item' | 'stock-txn' | 'purchase-order'
  mode         String // 'preview' | 'apply'
  status       String // 'pending' | 'running' | 'completed' | 'failed' | 'cancelled'
  totalRows    Int           @default(0)
  createRows   Int           @default(0)
  updateRows   Int           @default(0)
  skipRows     Int           @default(0)
  errorRows    Int           @default(0)
  startedAt    DateTime      @default(now())
  completedAt  DateTime?
  durationMs   Int?
  triggeredBy  String // user email
  siteScope    String?
  errorMessage String?
  retryOf      String?
  sourceCursor String?
  attempts     Int           @default(1)
  p2034Count   Int           @default(0)
  items        SyncRunItem[]
  createdAt    DateTime      @default(now())

  @@index([source, target, status])
  @@index([triggeredBy])
  @@index([siteScope, createdAt])
  @@index([status, createdAt])
}

// ============================================================
// 31) SyncRunItem — diff รายแถวจากการ sync
//     action: 'create' | 'update' | 'skip' | 'error'
//     status: 'pending' | 'applied' | 'skipped' | 'error'
// ============================================================
model SyncRunItem {
  id              String    @id @default(cuid())
  syncRunId       String
  syncRun         SyncRun   @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  externalKey     String
  action          String // 'create' | 'update' | 'skip' | 'error'
  before          Json?
  after           Json?
  expectedVersion Int?
  expectedExists  Boolean   @default(false)
  status          String // 'pending' | 'applied' | 'skipped' | 'error'
  errorMessage    String?
  entityId        String?
  entityType      String?
  processedAt     DateTime?

  @@index([syncRunId, action])
  @@index([externalKey])
  @@index([syncRunId, status])
}

// ============================================================
// 23) PMSchedule — ตารางงานบำรุงรักษาป้องกัน (Preventive Maintenance)
// ============================================================
model PMSchedule {
  id           String   @id @default(cuid())
  scheduleNo   String?  @unique
  title        String
  description  String?
  frequency    String   @default("monthly")
  intervalDays Int?
  dayOfMonth   Int?
  weekday      String?
  startMonth   Int?
  deviceType   String?
  site         String?
  building     String?
  floor        String?
  department   String?
  deviceId     String?
  checklist    String?
  active       Boolean  @default(true)
  startDate    String?
  lastRunDate  String?
  nextRunDate  String?
  autoCreateWO Boolean  @default(false)
  assignedTo   String?
  createdBy    String?
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  device     Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  executions PMExecution[]

  @@index([active, nextRunDate])
  @@index([frequency])
  @@index([site])
  @@index([deviceType])
  @@index([isDemo])
}

// ============================================================
// 24) PMExecution — ผลการทำ PM แต่ละครั้ง
// ============================================================
model PMExecution {
  id              String   @id @default(cuid())
  scheduleId      String
  workOrderId     String?
  scheduledDate   String
  executedDate    String?
  status          String   @default("PENDING")
  checklistResult String?
  remark          String?
  performedBy     String?
  images          String?
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  schedule PMSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, scheduledDate])
  @@index([status])
  @@index([scheduledDate])
  @@index([isDemo])
}

// ============================================================
// 30) WebAuthnCredential — ลายนิ้วมือ / Face ID / Touch ID / Passkey
// ============================================================
// รองรับ WebAuthn (FIDO2) login — ผู้ใช้ลงทะเบียน biometric จากอุปกรณ์
// แล้ว login ด้วย fingerprint แทน password ได้.
//
// Supports: Touch ID (macOS/iOS), Face ID (iOS), Windows Hello,
// Android fingerprint, hardware security keys (YubiKey).
// ============================================================
model WebAuthnCredential {
  id              String   @id // base64url credential ID (สำหรับ lookup)
  userId          String
  publicKey       Bytes    // COSE public key
  counter         Int      @default(0) // signature counter (replay protection)
  deviceType      String?  // 'touchid' | 'faceid' | 'windows-hello' | 'android-fingerprint' | 'security-key'
  transports      String?  // comma-separated: 'internal,hybrid,usb,nfc,ble'
  name            String?  // ชื่อที่ผู้ใช้ตั้งให้ device (e.g. "iPhone ของผม")
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// 31) DeviceAccessory — อุปกรณ์ต่อพ่วง (Accessories/Peripherals)
// ============================================================
// อุปกรณ์ที่ต่อพ่วงกับอุปกรณ์หลัก เช่น:
//   - คีย์บอร์ด, เมาส์, จอภาพ, สแกนเนอร์เสริม
//   - สายแลน, อะแดปเตอร์, UPS, USB hub
//   - หัวพิมพ์เสริม, ถาดกระดาษเสริม
//
// 1 อุปกรณ์หลัก → ได้หลายอุปกรณ์ต่อพ่วง
// สามารถย้ายระหว่างอุปกรณ์ได้ (change parentDeviceId)
// ============================================================
model DeviceAccessory {
  id              String   @id @default(cuid())
  parentDeviceId  String   // FK → Device.id (อุปกรณ์หลักที่ต่อพ่วงอยู่)
  accessoryType   String   // ประเภท: KEYBOARD | MOUSE | MONITOR | SCANNER | CABLE | ADAPTER | UPS | HUB | PRINTHEAD | TRAY | OTHER
  brand           String?  // ยี่ห้อ
  model           String?  // รุ่น
  serialNumber    String?  // หมายเลขซีเรียล
  status          String   @default("Active") // Active | Inactive | In Repair | Disposed
  installedDate   String?  // วันที่ติดตั้ง (ISO date)
  removedDate     String?  // วันที่ถอดออก (ถ้ามี)
  remark          String?  // หมายเหตุ
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parentDevice    Device   @relation(fields: [parentDeviceId], references: [id], onDelete: Cascade)

  @@index([parentDeviceId])
  @@index([accessoryType])
  @@index([status])
  @@index([isDemo])
}
