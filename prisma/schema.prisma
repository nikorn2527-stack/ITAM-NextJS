// ============================================================
// ITAM Database Schema — ตรงกับ PostgreSQL (Supabase) จริง
// ============================================================
// Schema นี้สอดคล้องกับ DB จริงที่ import ข้อมูลจาก Apps Script
// ทุก table ใช้ camelCase column names ตรงกับ DB (ไม่ใช้ @map/@@map ที่ไม่จำเป็น)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1) Device — อุปกรณ์ IT หลัก (2,378 รายการ)
//    assetCode = asset_no (เลขสินทรัพย์รวม ห้ามแก้ไขหลังสร้าง)
//    assetSiteCode = asset_site_code (รหัสประจำ Site เช่น UDH-00001)
// ============================================================
model Device {
  id              String   @id @default(cuid())
  assetCode       String   @unique // asset_no — เลขสินทรัพย์รวม ห้ามแก้ไข
  name            String   // ชื่ออุปกรณ์
  brand           String
  model           String
  type            String   // ประเภท: PRINTER | SCANNER | COMPUTER | NETWORK | OTHER
  serialNumber    String?  // serial
  status          String   @default("Active")
  site            String   // สาขา/ที่ตั้ง
  department      String?
  departmentCode  String?
  parentRef       String?
  assetSiteCode   String?  // asset_site_code — รหัสประจำ Site (SITE-NNNNN)
  location        String?
  building        String?
  floor           String?
  room            String?
  purchaseDate    String?  // ISO date
  purchasePrice   Float?
  salvageValue    Float?   @default(0)
  usefulLife      Int?
  warrantyMonths  Int      @default(12)
  warrantyEnd     String?
  vendor          String?
  contractNo      String?
  uninstallDate   String?
  meterRequired   Boolean  @default(false)
  meterMode       String?  // TOTAL | BW_COLOR
  lastMeterBw     Int      @default(0)
  lastMeterColor  Int      @default(0)
  ip              String?
  mac             String?
  remoteId        String?
  currentAssignee String?
  remark          String?
  costCenter      String?
  deviceGroup     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       String?  @default("System")

  // Relations
  meterReadings     MeterReading[]
  transfers         DeviceTransfer[]
  assignments       Assignment[]
  maintenanceLogs   MaintenanceLog[]
  workOrders        WorkOrder[]
  stockTransactions StockTransaction[]

  @@index([site])
  @@index([assetSiteCode])
  @@index([status])
  @@index([type])
  @@index([meterRequired])
}

// ============================================================
// 2) MeterReading — การจดมิเตอร์
// ============================================================
model MeterReading {
  id                       String   @id @default(cuid())
  readingId                String?  @unique
  deviceId                 String
  assetCode                String?  // asset_no — สำหรับ CSV import lookup
  readingDate              String   // ISO date
  readingMonth             String?  // YYYY-MM
  meterBw                  Int      @default(0)
  meterColor               Int      @default(0)
  pagesBw                  Int      @default(0)
  pagesColor               Int      @default(0)
  prevMeterBw              Int      @default(0)
  prevMeterColor           Int      @default(0)
  readingType              String?  // MONTHLY | INITIAL | FINAL | RESET | CHECKOUT | SEND_REPAIR | RETURN
  readBy                   String?
  remark                   String?
  locationAtReading        String?
  siteAtReading            String?
  buildingAtReading        String?
  floorAtReading           String?
  departmentAtReading      String?
  departmentCodeAtReading  String?
  eventType                String?
  eventId                  String?
  createdAt                DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([readingMonth])
}

// ============================================================
// 3) Cycle — รอบจดมิเตอร์
// ============================================================
model Cycle {
  id        String   @id @default(cuid())
  name      String
  startDate String
  endDate   String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// 4) DeviceTransfer — ประวัติการย้าย
// ============================================================
model DeviceTransfer {
  id                String   @id @default(cuid())
  logId             String?  @unique
  deviceId          String
  assetCode         String?  // Asset_No
  moveDate          String?
  action            String?  // TRANSFER | TRANSFER_SITE | STATUS_CHANGE | STATUS_AND_TRANSFER | TRANSFER_BY_LIFECYCLE
  fromStatus        String?
  toStatus          String?
  fromSite          String?
  fromAssetSiteCode String?
  fromBuilding      String?
  fromFloor         String?
  fromDepartment    String?
  fromLocation      String?
  toSite            String
  toAssetSiteCode   String?
  toBuilding        String?
  toFloor           String?
  toDepartment      String?
  toLocation        String?
  meterReadingId    String?
  movedBy           String?
  remark            String?
  transferDate      String
  reason            String?
  createdAt         DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([toSite])
}

// ============================================================
// 5) Assignment — การมอบหมายอุปกรณ์
// ============================================================
model Assignment {
  id                 String   @id @default(cuid())
  assignmentId       String?  @unique
  deviceId           String
  assignee           String
  assigneeRole       String?
  department         String?
  checkoutDate       String
  expectedReturnDate String?
  actualReturnDate   String?
  status             String   @default("active")
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([assignee])
}

// ============================================================
// 6) MaintenanceLog — ประวัติซ่อมบำรุง
// ============================================================
model MaintenanceLog {
  id           String   @id @default(cuid())
  logId        String?  @unique
  deviceId     String
  type         String   // repair | maintenance | inspection | upgrade
  status       String   @default("open")
  startDate    String
  endDate      String?
  cost         Float?
  vendor       String?
  description  String
  resolvedNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
}

// ============================================================
// 7) WorkOrder — ใบงานแจ้งซ่อม
// ============================================================
model WorkOrder {
  id               String   @id @default(cuid())
  woNumber         String?  @unique
  requestId        String?
  subject          String
  building         String?
  location         String?
  details          String?
  priority         String   @default("ปกติ")
  reporterName     String?
  reporterEmail    String?
  tel              String?
  employeeCode     String?
  submissionSource String   @default("guest")
  trackable        Boolean  @default(false)
  lineUserId       String?
  lineMessageId    String?
  printTemplateId  String?
  externalMeta     String?
  picBefore        String?
  picOnsite        String?
  picAfter         String?
  status           String   @default("PENDING")
  acceptStatus     String?
  assignedTo       String?
  assignedBy       String?
  assignedAt       DateTime?
  assignmentNote   String?
  detailsAdmin     String?
  dateAdmin        String?
  resolution       String?
  resolutionGroup  String?
  editUnlockActive Boolean  @default(false)
  editUnlockBy     String?
  editUnlockAt     DateTime?
  editUnlockNote   String?
  workCompletedAt  DateTime?
  closedAt         DateTime?
  canceledAt       DateTime?
  cancelReason     String?
  deviceId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  device   Device?            @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  messages WorkOrderMessage[]
  reviews  WorkOrderReview[]
  images   WorkOrderImage[]

  @@index([status])
  @@index([assignedTo])
  @@index([deviceId])
}

// ============================================================
// 8) WorkOrderMessage — แชทในใบงาน
// ============================================================
model WorkOrderMessage {
  id          String   @id @default(cuid())
  workOrderId String
  message     String
  author      String?
  authorRole  String?
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

// ============================================================
// 9) WorkOrderReview — คะแนนความพึงพอใจ
// ============================================================
model WorkOrderReview {
  id          String   @id @default(cuid())
  workOrderId String
  rating      Int
  comment     String?
  reviewedBy  String?
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

// ============================================================
// 10) WorkOrderImage — รูปภาพในใบงาน (หลายรูปต่อขั้นตอน)
// ============================================================
model WorkOrderImage {
  id          String   @id @default(cuid())
  workOrderId String
  stage       String   // before | onsite | after
  image_data  String
  fileName    String?
  uploadedBy  String?
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([stage])
  @@map("work_order_images")
}

// ============================================================
// 11) LicenseRecord — ลิขสิทธิ์ซอฟต์แวร์
// ============================================================
model LicenseRecord {
  id          String   @id @default(cuid())
  License_ID  String?
  Asset_No    String?  // links to Device.assetCode
  Software    String
  LicenseType String?  // OEM | Volume | Retail | Subscription | Open License
  License_Key String?
  Quantity    Int      @default(1)
  Expiry_Date String?
  Remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([Asset_No])
  @@map("license_records")
}

// ============================================================
// 12) SiteAttribute — ข้อมูลสาขา + อัตราค่ากระดาษ
//     Source: sheet "Site_Attributes"
// ============================================================
model SiteAttribute {
  id             String   @id @default(cuid())
  SiteCode       String   @unique // เช่น UDH, NKP, MECUD, PPIT
  SiteName       String?  // เช่น โรงพยาบาลศูนย์อุดรธานี
  LineOA         String?  // LINE OA ID/Token
  Hotline        String?  // เบอร์ติดต่อ
  PaperRateBW    Float?   @default(0.5) // ฿/แผ่น ขาวดำ
  PaperRateColor Float?   @default(2.0) // ฿/แผ่น สี
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("site_attributes")
}

// ============================================================
// 13) Site — สาขา (legacy, ใช้คู่กับ SiteAttribute)
// ============================================================
model Site {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
}

// ============================================================
// 14) SiteRate — อัตราค่ากระดาษต่อสาขา (legacy)
// ============================================================
model SiteRate {
  id        String   @id @default(cuid())
  siteCode  String
  bwRate    Float    @default(0.5)
  colorRate Float    @default(2.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteCode])
}

// ============================================================
// 15) MasterItem — ข้อมูลมาตรฐาน (Brand, Type, Model, Department, Status, DeviceGroup, Site)
// ============================================================
model MasterItem {
  id           String   @id @default(cuid())
  category     String   // Brand | Type | Model | Department | Status | DeviceGroup | Site
  code         String   // รหัส/คำย่อ เช่น HP, PRINTER, UDH
  label        String   // ชื่อแสดงผล
  parentRef    String?  // เช่น Brand|Type สำหรับ Model
  displayLabel String?  // ชื่อเต็ม/คำอธิบายเพิ่มเติม
  siteCode     String?  // รหัสสาขา (สำหรับ category=Site)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([code])
}

// ============================================================
// 16) StockItem — สินค้าในสต็อก
// ============================================================
model StockItem {
  id                String   @id @default(cuid())
  productCode       String
  productName       String
  category          String?
  brand             String?
  model             String?
  unit              String   @default("ชิ้น")
  quantity          Int      @default(0)
  minQuantity       Int      @default(0)
  maxQuantity       Int      @default(0)
  unitCost          Float?
  totalValue        Float?
  location          String?
  site              String?
  compatibleDevices String?
  remark            String?
  active            Boolean  @default(true)
  lastUpdated       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  transactions    StockTransaction[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([productCode])
  @@index([category])
}

// ============================================================
// 17) StockTransaction — รับเข้า/เบิกออก
// ============================================================
model StockTransaction {
  id              String   @id @default(cuid())
  txnNumber       String?
  stockItemId     String
  productCode     String?
  productName     String?
  type            String   // IN | OUT | ADJUST
  quantity        Int
  unit            String?
  balanceAfter    Int      @default(0)
  reason          String?
  requester       String?
  department      String?
  purpose         String?
  approver        String?
  approvedAt      String?
  workOrderId     String?
  workOrderNo     String?
  deviceId        String?
  cost            Float?
  unitCost        Float?
  vendor          String?
  receiver        String?
  purchaseOrderNo String?
  txnDate         String
  performedBy     String?
  remark          String?
  sourceKey       String?
  processedFlag   String?
  approvalStatus  String?
  approvalMode    String?
  autoApproveAt   String?
  rejectReason    String?
  createdAt       DateTime @default(now())

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  device    Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([stockItemId])
  @@index([type])
  @@index([approvalStatus])
}

// ============================================================
// 18) PurchaseOrder — ใบสั่งซื้อ
// ============================================================
model PurchaseOrder {
  id         String   @id @default(cuid())
  poNumber   String?
  orderDate  String
  supplier   String?
  status     String   @default("open")
  totalValue Float?
  createdBy  String?
  remark     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items PurchaseOrderItem[]

  @@index([status])
}

// ============================================================
// 19) PurchaseOrderItem — รายการในใบสั่งซื้อ
// ============================================================
model PurchaseOrderItem {
  id               String   @id @default(cuid())
  purchaseOrderId  String
  stockItemId      String
  quantityOrdered  Int
  quantityReceived Int      @default(0)
  unitPrice        Float?
  totalValue       Float?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  stockItem     StockItem     @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
}

// ============================================================
// 20) User — ผู้ใช้
// ============================================================
model User {
  id           String   @id @default(cuid())
  email        String
  username     String?
  name         String?
  role         String   @default("viewer")
  department   String?
  permissions  String?  // JSON string
  allowedSites String?  // comma-separated or ALL
  active       Boolean  @default(true)
  passwordHash String?
  avatarUrl    String?
  phone        String?
  lineUserId   String?
  lastLoginAt  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([role])
}

// ============================================================
// 21) AuditLog — ประวัติการเปลี่ยนแปลง
// ============================================================
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  summary   String
  detail    String?  // JSON string
  actor     String   @default("system")
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================
// 22) AppSetting — ตั้งค่าแอป
// ============================================================
model AppSetting {
  id       String   @id @default(cuid())
  key      String
  value    String
  updatedAt DateTime @updatedAt
}

// ============================================================
// 23) AssetNumberPattern — รูปแบบเลขทะเบียน
// ============================================================
model AssetNumberPattern {
  id            String   @id @default(cuid())
  name          String
  pattern       String
  description   String?
  isActive      Boolean  @default(false)
  defaultPrefix String?
  seqPadding    Int      @default(5)
  seqStart      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================================
// 24) OrganizationProfile — โปรไฟล์องค์กร
// ============================================================
model OrganizationProfile {
  id              String   @id @default(cuid())
  appName         String   @default("ระบบจัดการสินทรัพย์")
  appTagline      String   @default("Asset Management System")
  industryType    String   @default("general")
  logoUrl         String?
  primaryColor    String   @default("#f97316")
  accentColor     String   @default("#0d9488")
  language        String   @default("th")
  timezone        String   @default("Asia/Bangkok")
  currency        String   @default("THB")
  allowExcelImport Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// 25) DocumentTemplate — เทมเพลตเอกสาร
// ============================================================
model DocumentTemplate {
  id        String   @id @default(cuid())
  name      String
  type      String
  category  String?
  content   String
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  isFixed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// 26) ImportJob — งานนำเข้าข้อมูล
// ============================================================
model ImportJob {
  id            String   @id @default(cuid())
  jobType       String
  fileName      String
  fileType      String   @default("excel")
  status        String   @default("pending")
  totalRows     Int      @default(0)
  processedRows Int      @default(0)
  errorRows     Int      @default(0)
  errors        String?
  uploadedBy    String?
  createdAt     DateTime @default(now())
  completedAt   DateTime?
}

// ============================================================
// 27) LineBinding — ผูก LINE user กับผู้แจ้ง
// ============================================================
model LineBinding {
  id              String   @id @default(cuid())
  lineUserId      String
  lineDisplayName String?
  reporterName    String?
  tel             String?
  employeeCode    String?
  workOrderCount  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([lineUserId])
}

// ============================================================
// 28) Report — รายงานที่บันทึกไว้
// ============================================================
model Report {
  id       String   @id @default(cuid())
  type     String
  title    String
  rangeKey String?
  filters  String?
  data     String
  format   String   @default("json")
  createdAt DateTime @default(now())
}
