# ============================================================
# ITAM-NextJS Environment Variables
# ============================================================
# HOW TO USE:
#   1. Copy this file to `.env` (NOT .env.local — Prisma reads .env)
#   2. Set DATABASE_URL to a PostgreSQL connection string (Phase 1 baseline)
#   3. Set JWT_SECRET to a random 32+ char string
#   4. Run `bash setup.sh` (Linux/Mac) or `.\setup.ps1` (Windows)
#
# Phase 1 baseline: PostgreSQL is the ONLY supported database.
# SQLite was removed because it caused schema/migration drift — the
# committed schema.prisma uses `provider = "postgresql"` and there are
# 11 migrations in prisma/migrations/ that only work on PostgreSQL.
# ============================================================

# ── Database (PostgreSQL — REQUIRED) ──
# Local dev (default):
DATABASE_URL=postgresql://itam_app:CHANGE_ME@localhost:5432/itam_local?schema=public
# Supabase / managed Postgres example:
# DATABASE_URL=postgresql://postgres.xxxx:password@xxxx.pooler.supabase.com:6543/postgres?pgbouncer=true
# URL-encode special chars in password (@, :, /, etc.) with %xx sequences.

# ── Auth (REQUIRED) ──
# Generate a random secret:
#   Linux/Mac:  openssl rand -hex 32
#   PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})
JWT_SECRET=CHANGE_ME_TO_RANDOM_32_CHAR_STRING

# ── Backup Encryption (REQUIRED for production/LAN) ──
# Backup files are encrypted with AES-256-GCM. In production/LAN mode,
# backup-db.ts REFUSES to run without this key. In dev mode it just warns.
# Generate with: openssl rand -hex 32
# BACKUP_ENCRYPTION_KEY=

# ── Google Sheets Integration (optional — for legacy data sync) ──
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
# GOOGLE_SHEETS_ID_ITAM=
# GOOGLE_SHEETS_ID_SERVICES=
# GOOGLE_SHEETS_ID_STOCK=

# ── Node ──
NODE_ENV=development

# ── Restore Guard (scripts/restore-db.ts) ──
# RESTORE_CONFIRM=YES   # must be set to confirm a destructive restore

# ── Runtime ──
PORT=3000
