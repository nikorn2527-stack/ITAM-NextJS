# ============================================================
# Environment Variables for ITAM (IT Asset Management)
# ============================================================
# Copy these to your Vercel project settings → Environment Variables.
# Generate real values for Production / Preview / Development.

# ── Database (Supabase PostgreSQL) ─────────────────────────
# Use the POOLER URL (port 5432 or 6543) with pgbouncer for serverless.
# Get from: Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20"

# ── Auth (JWT) ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# ── Web Push (VAPID keys) ──────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="BJw8ri0jyng5IJA1c1XswdII2ucE69Rb1E2tsBQBdzkikMAgNS4LZKwkPpIezzwLO-Dr_qrG9or7H_EDgg3_YQk"
VAPID_PRIVATE_KEY="_LfCZWo0vYVrfYoxZJP2xYLBFDEaoNcUa9BhYZovEbM"
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# ── NextAuth (optional — if using NextAuth) ────────────────
# NEXTAUTH_URL="https://your-app.vercel.app"
# NEXTAUTH_SECRET="another-long-random-secret"

# ── App URL (for callbacks / emails) ──────────────────────
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# ── Cron job auth (optional) ──────────────────────────────
# CRON_SECRET="secret-to-protect-cron-endpoints"
