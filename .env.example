# PostgreSQL connection string for Supabase.
# URL-encode special characters in the password when required.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Use a long random value in every deployed environment.
JWT_SECRET="replace-with-a-long-random-secret"

# Required when the Vercel Cron job for stock auto-approval is enabled.
# Vercel sends this value as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET="replace-with-a-long-random-cron-secret"

# Optional: only needed if the NextAuth integration is enabled.
NEXTAUTH_SECRET="replace-with-a-long-random-nextauth-secret"
