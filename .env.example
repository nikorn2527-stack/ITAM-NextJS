# ============================================================
# ITAM-NextJS Environment Variables
# ============================================================
# คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกค่าจริง
# ห้าม commit .env.local (อยู่ใน .gitignore แล้ว)
# ============================================================

# ── Database ──
# SQLite (development):
DATABASE_URL=file:./db/custom.db
# PostgreSQL (production — ใช้เมื่อ deploy):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# ── Auth ──
JWT_SECRET=CHANGE_ME_TO_RANDOM_32_CHAR_STRING

# ── Google Sheets Integration (optional) ──
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
# GOOGLE_SHEETS_ID_ITAM=
# GOOGLE_SHEETS_ID_SERVICES=
# GOOGLE_SHEETS_ID_STOCK=

# ── Supabase (for migration/restore scripts only) ──
# SUPABASE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# ── Restore Guard (scripts/restore-from-supabase-v2.ts) ──
# RESTORE_CONFIRM=YES  # ต้องตั้งเพื่อยืนยัน restore
# DEV_DB_PUSH=1         # ต้องตั้งเพื่อยอมรับ db:push ใน dev

# ── Node ──
NODE_ENV=development
