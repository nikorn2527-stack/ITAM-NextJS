# ============================================================
# ITAM-NextJS Environment Variables
# ============================================================
# HOW TO USE:
#   1. Copy this file to `.env` (NOT .env.local — Prisma reads .env)
#   2. Pick ONE database mode below (dev=SQLite OR prod=PostgreSQL)
#   3. Set JWT_SECRET to a random 32+ char string
#   4. Run `bun run db:push` (Linux/Mac) or the setup script (Windows)
# ============================================================

# ── Database (PICK ONE — uncomment the mode you want) ──

# Mode A: SQLite (recommended for local dev — zero setup, file-based)
DATABASE_URL=file:./db/custom.db

# Mode B: PostgreSQL (for production / Supabase / self-hosted)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
# Example (Supabase transaction pooler):
# DATABASE_URL=postgresql://postgres.xxxx:password@xxxx.pooler.supabase.com:6543/postgres?pgbouncer=true

# Note: The `scripts/set-prisma-provider.mjs` hook (runs automatically before
# every db:push / build) will sync `prisma/schema.prisma` `provider` with your
# DATABASE_URL in dev mode — so you don't need to edit schema.prisma by hand.
#   • file:      → provider = "sqlite"
#   • postgresql → provider = "postgresql"

# ── Auth (REQUIRED) ──
# Generate a random secret: run `openssl rand -hex 32` (Linux/Mac)
# or in PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})
JWT_SECRET=CHANGE_ME_TO_RANDOM_32_CHAR_STRING

# ── Google Sheets Integration (optional — for legacy data sync) ──
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
# GOOGLE_SHEETS_ID_ITAM=
# GOOGLE_SHEETS_ID_SERVICES=
# GOOGLE_SHEETS_ID_STOCK=

# ── Supabase (for migration/restore scripts only) ──
# SUPABASE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# ── Restore Guard (scripts/restore-from-supabase-v2.ts) ──
# RESTORE_CONFIRM=YES   # must be set to confirm a destructive restore
# DEV_DB_PUSH=1         # must be set to accept db:push in dev after a restore

# ── Node ──
NODE_ENV=development
