# ============================================================
# Environment Variables for ITAM (IT Asset Management)
# ============================================================
# Copy these to your Vercel project settings → Environment Variables.
# Generate real values for Production / Preview / Development.
#
# Legend:
#   [REQUIRED]  — app won't work without this
#   [OPTIONAL]  — feature is disabled if not set
#   [AUTO]      — Vercel sets automatically, don't set manually

# ── Database (Supabase PostgreSQL) ─────────────────────────
# [REQUIRED] Use the POOLER URL with pgbouncer for serverless.
# Get from: Supabase Dashboard → Settings → Database → Connection string
# Use port 6543 (transaction mode) for higher concurrency on Free plan.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20"

# [OPTIONAL] Override provider auto-detection (sqlite|postgresql|mysql)
# DATABASE_PROVIDER="postgresql"

# [OPTIONAL] Connection pool tuning (defaults: limit=1, timeout=20)
# DATABASE_CONNECTION_LIMIT="1"
# DATABASE_POOL_TIMEOUT="20"

# ── Auth (JWT) ─────────────────────────────────────────────
# [REQUIRED] Generate with: openssl rand -base64 32
# This signs JWT tokens for user authentication.
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# [OPTIONAL] NextAuth.js (if using NextAuth instead of custom JWT)
# NEXTAUTH_SECRET="another-long-random-secret"
# NEXTAUTH_URL="https://your-app.vercel.app"

# ── Web Push Notifications (VAPID keys) ────────────────────
# [OPTIONAL — required for browser push notifications]
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="BJw8ri0jyng5IJA1c1XswdII2ucE69Rb1E2tsBQBdzkikMAgNS4LZKwkPpIezzwLO-Dr_qrG9or7H_EDgg3_YQk"
VAPID_PRIVATE_KEY="_LfCZWo0vYVrfYoxZJP2xYLBFDEaoNcUa9BhYZovEbM"
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# ── Cron Job Authentication ────────────────────────────────
# [OPTIONAL — if not set, cron endpoints are open in dev mode]
# Set this to protect /api/cron/* endpoints from abuse.
# Generate with: openssl rand -hex 32
# Vercel cron automatically sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="replace-with-random-hex-32-chars"

# ── Supabase Realtime (optional — replaces polling) ──────
# [OPTIONAL — enables real-time updates instead of 60s polling]
# Get from: Supabase Dashboard → Settings → API
# NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_KEY="your-service-role-key"  # server-side only!

# ── Vercel Blob Storage (file uploads) ────────────────────
# [OPTIONAL — required for image uploads (WO photos, stickers)]
# Get from: Vercel Dashboard → Storage → Create Blob Store
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxx"

# ── App URL (for callbacks / emails) ──────────────────────
# [OPTIONAL — Vercel sets automatically, but useful for emails]
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# ── Authorization Migration (advanced) ────────────────────
# [OPTIONAL — RBAC migration mode, leave defaults for new deploys]
# AUTHZ_LEGACY_ALL_FAIL_OPEN="false"  # if true, unknown permissions allow access
# AUTHZ_MIGRATION_MODE="false"

# ── Google Sheets Sync (optional) ────────────────────────
# [OPTIONAL — for importing from Google Sheets]
# GOOGLE_SHEETS_ID_ITAM="your-google-sheet-id"
# GOOGLE_SHEETS_ID_SERVICES="your-services-sheet-id"
# GOOGLE_SHEETS_ID_STOCK="your-stock-sheet-id"

# ── Sync Tuning (optional) ───────────────────────────────
# SYNC_PREVIEW_MAX_ROWS="1000"
# SYNC_SOURCE_MAX_RETRIES="3"
# SYNC_SOURCE_TIMEOUT_MS="30000"

# ── Debugging ────────────────────────────────────────────
# [OPTIONAL — set to "true" to log all Prisma SQL queries]
# PRISMA_LOG_QUERIES="false"

# ============================================================
# Variables set automatically by Vercel (do NOT set manually):
#   VERCEL_DEPLOYMENT_ID
#   VERCEL_GIT_COMMIT_SHA
#   VERCEL_REGION
#   NODE_ENV (set to "production" by Vercel)
# ============================================================

# ============================================================
# Quick Start Checklist for Vercel Deploy:
# ============================================================
# 1. REQUIRED (set all 5):
#    - DATABASE_URL (Supabase pooler URL with ?pgbouncer=true)
#    - JWT_SECRET (openssl rand -base64 32)
#    - VAPID_PUBLIC_KEY + VAPID_PRIVATE_KEY + VAPID_SUBJECT
#
# 2. RECOMMENDED:
#    - CRON_SECRET (openssl rand -hex 32)
#    - BLOB_READ_WRITE_TOKEN (if using file uploads)
#
# 3. OPTIONAL (feature-gated):
#    - NEXT_PUBLIC_SUPABASE_URL + keys (realtime)
#    - GOOGLE_SHEETS_ID_* (sync)
#    - NEXT_PUBLIC_APP_URL (emails)
# ============================================================
