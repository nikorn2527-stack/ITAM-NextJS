# ============================================================
# Environment Variables for ITAM (IT Asset Management)
# ============================================================
# Copy these to your Vercel project settings → Environment Variables.
#
# Legend:
#   [REQUIRED]    — app won't work without this
#   [RECOMMENDED] — strongly suggested for production stability
#   [OPTIONAL]    — feature is disabled if not set
#   [AUTO]        — Vercel sets automatically, don't set manually

# ═══════════════════════════════════════════════════════════
# REQUIRED (set all 5 — app won't work without these)
# ═══════════════════════════════════════════════════════════

# ── Database (Supabase PostgreSQL) ─────────────────────────
# Use POOLER URL (port 6543 = transaction mode, 200 connections on Free).
# Get from: Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20"

# ── Auth (JWT) ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# ── Web Push Notifications (VAPID keys) ────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="BJw8ri0jyng5IJA1c1XswdII2ucE69Rb1E2tsBQBdzkikMAgNS4LZKwkPpIezzwLO-Dr_qrG9or7H_EDgg3_YQk"
VAPID_PRIVATE_KEY="_LfCZWo0vYVrfYoxZJP2xYLBFDEaoNcUa9BhYZovEbM"
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# ═══════════════════════════════════════════════════════════
# RECOMMENDED (for production stability)
# ═══════════════════════════════════════════════════════════

# ── Cron Job Authentication ────────────────────────────────
# Protects /api/cron/* endpoints from abuse.
# Generate with: openssl rand -hex 32
# Vercel cron automatically sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="replace-with-random-hex-32-chars"

# ── Supabase Realtime (replaces polling — 90% fewer API calls) ──
# Get from: Supabase Dashboard → Settings → API
# NEXT_PUBLIC_SUPABASE_URL — client-side (browser reads this)
# NEXT_PUBLIC_SUPABASE_ANON_KEY — client-side (browser reads this)
# SUPABASE_SERVICE_KEY — server-side only (bypasses RLS, keep secret!)
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_KEY="your-service-role-key-keep-secret"

# ── Vercel Blob Storage (file uploads: WO photos, exports) ──
# Get from: Vercel Dashboard → Storage → Create → Blob Store
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxx"

# ── Vercel KV (distributed rate limiting across instances) ──
# Get from: Vercel Dashboard → Storage → Create → KV
# Without this, rate limiting is per-instance (less accurate)
KV_REST_API_URL="https://your-kv.vercel.app"
KV_REST_API_TOKEN="your-kv-token"

# ── Vercel Edge Config (feature flags, maintenance mode) ──
# Get from: Vercel Dashboard → Storage → Create → Edge Config
# Without this, maintenance mode / read-only mode won't work
EDGE_CONFIG="ec_xxxxx"

# ═══════════════════════════════════════════════════════════
# OPTIONAL (feature-gated)
# ═══════════════════════════════════════════════════════════

# ── NextAuth.js (alternative auth — if using NextAuth) ──
# NEXTAUTH_SECRET="another-long-random-secret"
# NEXTAUTH_URL="https://your-app.vercel.app"

# ── App URL (for callbacks / emails) ──────────────────────
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# ── Database pool tuning (advanced) ───────────────────────
# DATABASE_PROVIDER="postgresql"
# DATABASE_CONNECTION_LIMIT="1"
# DATABASE_POOL_TIMEOUT="20"

# ── Cloudflare R2 (RECOMMENDED — image uploads, no egress fees) ──
# Sign up: https://dash.cloudflare.com → R2 (free 10GB)
# Create bucket + API token, then set these env vars.
# R2 has NO egress fees (vs Vercel Blob/Supabase which charge for reads)
# → Perfect for serving images to many users.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="itam-uploads"
# R2_PUBLIC_URL="https://pub-xxxx.r2.dev"  # or custom domain

# ── Apple Sign In OAuth ────────────────────────────────────
# Setup: https://developer.apple.com → Certificates, Identifiers & Profiles
#   1. Create Services ID (e.g. com.yourapp.signin) → oauth_apple_client_id
#   2. Note Team ID (10 chars) → oauth_apple_team_id
#   3. Create Key (Sign In with Apple) → oauth_apple_key_id + private key
# OAUTH_APPLE_CLIENT_ID="com.yourapp.signin"
# OAUTH_APPLE_TEAM_ID="XXXXXXXXXX"
# OAUTH_APPLE_KEY_ID="XXXXXXXXXX"
# OAUTH_APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
# OAUTH_APPLE_REDIRECT_URL="https://your-app.vercel.app/api/auth/oauth/apple/callback"

# ── Authorization migration (advanced) ────────────────────
# AUTHZ_LEGACY_ALL_FAIL_OPEN="false"
# AUTHZ_MIGRATION_MODE="false"

# ── Google Sheets Sync (optional) ────────────────────────
# GOOGLE_SHEETS_ID_ITAM="your-google-sheet-id"
# GOOGLE_SHEETS_ID_SERVICES="your-services-sheet-id"
# GOOGLE_SHEETS_ID_STOCK="your-stock-sheet-id"

# ── Sync tuning (optional) ────────────────────────────────
# SYNC_PREVIEW_MAX_ROWS="1000"
# SYNC_SOURCE_MAX_RETRIES="3"
# SYNC_SOURCE_TIMEOUT_MS="30000"

# ── Debugging ────────────────────────────────────────────
# PRISMA_LOG_QUERIES="false"

# ═══════════════════════════════════════════════════════════
# AUTO (set by Vercel — do NOT set manually)
# ═══════════════════════════════════════════════════════════
# VERCEL_DEPLOYMENT_ID
# VERCEL_GIT_COMMIT_SHA
# VERCEL_REGION
# NODE_ENV (set to "production" by Vercel)

# ═══════════════════════════════════════════════════════════
# Quick Start Checklist for Vercel Deploy
# ═══════════════════════════════════════════════════════════
#
# MINIMUM (app works):
#   1. DATABASE_URL (Supabase pooler URL)
#   2. JWT_SECRET
#   3. VAPID_PUBLIC_KEY + VAPID_PRIVATE_KEY + VAPID_SUBJECT
#
# RECOMMENDED (production stability):
#   4. CRON_SECRET
#   5. NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY + SUPABASE_SERVICE_KEY
#   6. BLOB_READ_WRITE_TOKEN
#   7. KV_REST_API_URL + KV_REST_API_TOKEN
#   8. EDGE_CONFIG
#
# After deploy:
#   9. Create Supabase Storage bucket 'wo-photos' (public) for image uploads
#   10. Set up Vercel Analytics (already installed — auto)
#   11. Set up uptime monitoring on /api/health-edge (UptimeRobot free)
#
# Feature flags (via Edge Config API):
#   curl -X PATCH "https://api.vercel.com/v1/edge-config/{EC_ID}/items?teamId={TEAM}" \
#     -H "Authorization: Bearer {TOKEN}" \
#     -H "Content-Type: application/json" \
#     -d '{ "items": [{ "operation": "upsert", "key": "feature.maintenanceMode", "value": false }] }'
# ═══════════════════════════════════════════════════════════

# Google Service Account for Sheets API v4 (sync from legacy apps)
# JSON key file content as a string (copy entire JSON)
GOOGLE_SERVICE_ACCOUNT_KEY=
