+const cats = db.prepare("SELECT category, count(*) as c FROM MasterItem GROUP BY category ORDER BY c DESC").all()
+console.log('Categories:')
+cats.forEach(c => console.log(`  ${c.category}: ${c.c}`))
+
+db.close()
